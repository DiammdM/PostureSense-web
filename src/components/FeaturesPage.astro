---
import { getLocaleFromPath, type Locale } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);

const content: Record<Locale, {
  eyebrow: string;
  title: string;
  intro: string;
  noticesEyebrow: string;
  noticesTitle: string;
  notices: [string, string][];
  reminderNumber: string;
  reminderTitle: string;
  reminderBody: string;
  reminderMeta: string[];
  rhythmNumber: string;
  rhythmTitle: string;
  rhythmBody: string;
  duration: string;
  durationBody: string;
  history: string;
  historyBody: string;
  deskTitle: string;
  deskBody: string;
  privacyTitle: string;
  privacyBody: string;
  localLabel: string;
}> = {
  en: {
    eyebrow: 'Features',
    title: 'Notice posture changes without breaking your focus.',
    intro: 'Posturely watches for visible posture changes on your device and gives you a gentle reminder when you need one.',
    noticesEyebrow: 'What it notices',
    noticesTitle: 'Four ways your posture can shift.',
    notices: [
      ['Head down', 'Notices when your head stays lower than your reference posture.'],
      ['Forward lean', 'Notices when your upper body keeps moving forward.'],
      ['Body tilt', 'Notices a clear lean to either side.'],
      ['Posture change', 'Compares sustained changes with your current session reference.'],
    ],
    reminderNumber: '01',
    reminderTitle: 'A gentle reminder, when you need it.',
    reminderBody: 'Bring your attention back to your posture without interrupting the whole session.',
    reminderMeta: ['Sound', 'Vibration', 'Adjustable sensitivity'],
    rhythmNumber: '02',
    rhythmTitle: 'Start at your own pace.',
    rhythmBody: 'Choose a session length and return to studying, reading, or working.',
    duration: 'Session duration',
    durationBody: 'Set the time that fits the task.',
    history: 'Reminder history',
    historyBody: 'Look back at when reminders happened.',
    deskTitle: 'Designed for desk time.',
    deskBody: 'Place your iPhone or iPad on a stable stand with your upper body clearly in view.',
    privacyTitle: 'Camera frames stay on your device.',
    privacyBody: 'Camera frames used for posture detection are processed locally and are not uploaded to any server.',
    localLabel: 'Local processing · Privacy by design',
  },
  zh: {
    eyebrow: '功能',
    title: '看见坐姿变化，也不打断专注。',
    intro: 'Posturely 在设备本地留意你的坐姿，在需要时轻轻提醒。',
    noticesEyebrow: '它会留意什么',
    noticesTitle: '从这四个方面，留意坐姿状态。',
    notices: [
      ['低头', '留意头部是否持续向下移动。'],
      ['身体前倾', '留意上半身是否持续向前移动。'],
      ['身体倾斜', '留意上半身是否明显向一侧倾斜。'],
      ['明显坐姿变化', '与本次监督建立的参考姿态进行比较。'],
    ],
    reminderNumber: '01',
    reminderTitle: '需要时，轻轻提醒。',
    reminderBody: '学习、阅读或工作太投入时，Posturely 会轻轻提醒你留意坐姿。',
    reminderMeta: ['声音提醒', '震动提醒', '灵敏度可调'],
    rhythmNumber: '02',
    rhythmTitle: '按你的节奏开始。',
    rhythmBody: '选择监督时长，然后继续学习、阅读或工作。',
    duration: '监督时长',
    durationBody: '选择适合这次专注的时间。',
    history: '提醒历史',
    historyBody: '回顾提醒出现的时刻。',
    deskTitle: '为桌面使用而设计。',
    deskBody: '把 iPhone 或 iPad 放在稳定支架上，让上半身清晰可见。',
    privacyTitle: '画面只留在设备里。',
    privacyBody: '摄像头画面仅在设备本地处理，不会上传到任何服务器。',
    localLabel: '本地处理 · 隐私安全',
  },
  ja: {
    eyebrow: '機能',
    title: '姿勢の変化に気づいても、集中は妨げない。',
    intro: 'Posturely はデバイス上で姿勢を確認し、必要なときにやさしく知らせます。',
    noticesEyebrow: '確認する変化',
    noticesTitle: '4つの変化から、姿勢に気づく。',
    notices: [
      ['うつむき', '頭が下がった状態が続いていないか確認します。'],
      ['前傾', '上半身が前へ動き続けていないか確認します。'],
      ['体の傾き', '上半身が左右に大きく傾いていないか確認します。'],
      ['姿勢の変化', '現在のセッションで設定した姿勢と比べます。'],
    ],
    reminderNumber: '01',
    reminderTitle: '必要なときに、そっと通知。',
    reminderBody: '集中しているときも、姿勢へ自然に意識を戻せます。',
    reminderMeta: ['音の通知', '振動の通知', '感度を調整'],
    rhythmNumber: '02',
    rhythmTitle: '自分のペースで始める。',
    rhythmBody: '時間を選んだら、そのまま勉強、読書、仕事を続けられます。',
    duration: 'セッション時間',
    durationBody: '作業に合う時間を選べます。',
    history: '通知履歴',
    historyBody: '通知されたタイミングを振り返れます。',
    deskTitle: 'デスク時間のための設計。',
    deskBody: 'iPhone または iPad を安定したスタンドに置き、上半身が見えるようにします。',
    privacyTitle: '映像はデバイスの中だけ。',
    privacyBody: '姿勢検出に使うカメラ映像はデバイス上で処理され、どのサーバーにもアップロードされません。',
    localLabel: 'オンデバイス処理 · プライバシー重視',
  },
};

const copy = content[locale];
---

<article class={`features-page lang-${locale}`} data-features-page>
  <section class="features-hero">
    <div class="features-container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-page-reveal>{copy.eyebrow}</p>
        <h1 data-page-reveal data-page-delay="80">{locale === 'zh' ? <><span class="hero-title-line">看见坐姿变化，</span><span class="hero-title-line">也不打断专注。</span></> : copy.title}</h1>
        <p class="hero-intro" data-page-reveal data-page-delay="160">{copy.intro}</p>
      </div>

      <div class="hero-scene" data-page-reveal="scale" data-page-delay="100" aria-hidden="true">
        <img
          src="/images/features/hero-scene-v2.webp"
          srcset="/images/features/hero-scene-v2-768.webp 768w, /images/features/hero-scene-v2.webp 1536w"
          sizes="(max-width: 720px) calc(100vw - 32px), 52vw"
          alt=""
          width="1536"
          height="1001"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="notices-section">
    <div class="features-container notices-shell" data-features-reveal>
      <header class="notices-heading">
        <p class="eyebrow">{copy.noticesEyebrow}</p>
        <h2>{copy.noticesTitle}</h2>
      </header>

      <div class="notice-item notice-left-top">
        <span aria-hidden="true">↓</span>
        <div><h3>{copy.notices[0][0]}</h3><p>{copy.notices[0][1]}</p></div>
      </div>
      <div class="notice-item notice-left-bottom">
        <span aria-hidden="true">↘</span>
        <div><h3>{copy.notices[2][0]}</h3><p>{copy.notices[2][1]}</p></div>
      </div>

      <div class="posture-radar" aria-hidden="true">
        <img
          src="/images/features/posture-radar-v2.webp"
          srcset="/images/features/posture-radar-v2-720.webp 720w, /images/features/posture-radar-v2.webp 1170w"
          sizes="(max-width: 600px) calc(100vw - 32px), 390px"
          alt=""
          width="1170"
          height="1254"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="notice-item notice-right-top">
        <span aria-hidden="true">↗</span>
        <div><h3>{copy.notices[1][0]}</h3><p>{copy.notices[1][1]}</p></div>
      </div>
      <div class="notice-item notice-right-bottom">
        <span aria-hidden="true">≈</span>
        <div><h3>{copy.notices[3][0]}</h3><p>{copy.notices[3][1]}</p></div>
      </div>
    </div>
  </section>

  <section class="capabilities-section">
    <div class="features-container capability-grid capability-reminders" data-features-reveal>
      <div class="capability-copy">
        <span class="capability-number">{copy.reminderNumber}</span>
        <h2>{copy.reminderTitle}</h2>
        <p>{copy.reminderBody}</p>
        <ul>
          {copy.reminderMeta.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="capability-art reminder-art" aria-hidden="true">
        <img
          src="/images/features/reminder-device-v2.webp"
          srcset="/images/features/reminder-device-v2-800.webp 800w, /images/features/reminder-device-v2.webp 1629w"
          sizes="(max-width: 720px) calc(100vw - 32px), 50vw"
          alt=""
          width="1629"
          height="966"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="features-container capability-grid capability-rhythm" data-features-reveal>
      <div class="capability-art timer-art" aria-hidden="true">
        <img
          src="/images/features/timer-device-v2.webp"
          srcset="/images/features/timer-device-v2-800.webp 800w, /images/features/timer-device-v2.webp 1508w"
          sizes="(max-width: 720px) calc(100vw - 32px), 50vw"
          alt=""
          width="1508"
          height="1043"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="capability-copy">
        <span class="capability-number">{copy.rhythmNumber}</span>
        <h2>{copy.rhythmTitle}</h2>
        <p>{copy.rhythmBody}</p>
        <div class="rhythm-meta">
          <div><span class="meta-icon" aria-hidden="true">◷</span><div><strong>{copy.duration}</strong><small>{copy.durationBody}</small></div></div>
          <div><span class="meta-icon" aria-hidden="true">□</span><div><strong>{copy.history}</strong><small>{copy.historyBody}</small></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="feature-panels">
    <div class="features-container">
      <article class="desk-panel" data-features-reveal>
        <div>
          <h2>{copy.deskTitle}</h2>
          <p>{copy.deskBody}</p>
        </div>
        <img
          class="desk-visual"
          src="/images/features/desk-scene-v2.webp"
          srcset="/images/features/desk-scene-v2-720.webp 720w, /images/features/desk-scene-v2.webp 1774w"
          sizes="(max-width: 720px) calc(100vw - 32px), 50vw"
          alt=""
          width="1774"
          height="773"
          loading="lazy"
          decoding="async"
        />
      </article>

      <article class="privacy-panel" data-features-reveal>
        <div class="privacy-copy">
          <h2>{copy.privacyTitle}</h2>
          <p>{copy.privacyBody}</p>
        </div>
        <img
          class="privacy-diagram"
          src="/images/features/privacy-diagram-v2.webp"
          srcset="/images/features/privacy-diagram-v2-720.webp 720w, /images/features/privacy-diagram-v2.webp 1792w"
          sizes="(max-width: 720px) calc(100vw - 32px), 50vw"
          alt=""
          width="1792"
          height="717"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </article>

    </div>
  </section>
</article>

<style>
  .features-page {
    overflow: hidden;
    background: var(--paper);
  }

  .features-container {
    width: min(calc(100% - clamp(2rem, 6vw, 4.2rem)), 1180px);
    margin-inline: auto;
  }

  .features-hero {
    border-bottom: 1px solid var(--border);
    padding: clamp(2.4rem, 3.4vw, 3.2rem) 0 clamp(2rem, 2.8vw, 2.6rem);
  }

  .hero-grid {
    display: grid;
    min-height: 400px;
    grid-template-columns: minmax(0, 0.88fr) minmax(440px, 1.12fr);
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero-copy h1 {
    max-width: 590px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.1rem, 4.2vw, 4.2rem);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .lang-en .hero-copy h1 {
    font-size: clamp(3.15rem, 4.35vw, 4.35rem);
    letter-spacing: -0.062em;
  }

  .lang-ja .hero-copy h1 {
    font-size: clamp(3rem, 4.1vw, 4.1rem);
  }

  .lang-zh .hero-copy h1 {
    font-size: clamp(43px, 4.4vw, 62px);
  }

  .hero-title-line {
    display: block;
    white-space: nowrap;
  }

  .hero-intro {
    max-width: 620px;
    margin: 1.65rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.35vw, 1.16rem);
  }

  .hero-scene {
    position: relative;
    min-height: 400px;
  }

  .hero-orbit {
    position: absolute;
    inset: 0;
    border-radius: 49% 51% 44% 56% / 52% 46% 54% 48%;
    background: var(--paper-blob);
    transform: rotate(-5deg);
  }

  .hero-scene svg {
    position: absolute;
    z-index: 1;
    right: -2%;
    bottom: 0;
    width: 108%;
    stroke: var(--text);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scene-faint {
    stroke: rgba(17, 19, 17, 0.27);
  }

  .hero-hair {
    fill: var(--text);
    stroke: none;
  }

  .device-screen {
    fill: var(--dark);
    stroke: var(--dark);
  }

  .scene-accent,
  .lime-stroke,
  .panel-accent {
    stroke: #72a900;
  }

  .desk-line {
    stroke: rgba(17, 19, 17, 0.54);
  }

  .hero-device {
    transform-origin: 165px 266px;
    animation: device-breathe 4.6s ease-in-out infinite;
  }

  .notices-section {
    background: var(--paper-soft);
    color: var(--paper);
    padding: clamp(1rem, 2vw, 1.5rem) 0 0;
  }

  .notices-shell {
    display: grid;
    grid-template-columns: minmax(210px, 0.8fr) minmax(330px, 1.4fr) minmax(210px, 0.8fr);
    grid-template-rows: auto 1fr 1fr;
    align-items: center;
    min-height: 570px;
    row-gap: 0;
    column-gap: clamp(1.4rem, 3.2vw, 3.2rem);
    overflow: hidden;
    border-radius: 28px;
    background: var(--dark);
    padding: clamp(2.3rem, 3vw, 3.2rem);
  }

  .notices-heading {
    grid-column: 1 / -1;
    margin-bottom: 0;
  }

  .notices-heading .eyebrow {
    color: var(--accent);
  }

  .notices-heading h2 {
    max-width: 460px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 4.25vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 1.02;
  }

  .notice-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    align-items: start;
    gap: 1rem;
  }

  .notice-item > span {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid rgba(248, 245, 239, 0.18);
    border-radius: 50%;
    color: var(--accent);
    font-size: 1.1rem;
  }

  .notice-item h3 {
    margin: 0;
    font-size: 1.03rem;
    font-weight: 720;
    letter-spacing: -0.025em;
  }

  .notice-item p {
    margin: 0.38rem 0 0;
    color: rgba(248, 245, 239, 0.5);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .notice-left-top,
  .notice-right-top {
    align-self: end;
  }

  .notice-left-bottom,
  .notice-right-bottom {
    align-self: start;
  }

  .posture-radar {
    position: relative;
    display: grid;
    width: min(100%, 390px);
    aspect-ratio: 1;
    grid-column: 2;
    grid-row: 2 / 4;
    place-items: center;
    justify-self: center;
  }

  .radar-ring {
    position: absolute;
    border: 1px solid rgba(184, 255, 25, 0.24);
    border-radius: 50%;
  }

  .ring-one { inset: 4%; }
  .ring-two { inset: 18%; }
  .ring-three { inset: 32%; }

  .posture-radar svg {
    position: relative;
    z-index: 1;
    width: 78%;
    stroke: rgba(248, 245, 239, 0.82);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .radar-axis {
    stroke: rgba(184, 255, 25, 0.19);
    stroke-dasharray: 2 7;
  }

  .radar-chair {
    stroke: rgba(248, 245, 239, 0.38);
  }

  .radar-dots {
    fill: var(--accent);
    stroke: var(--dark);
    stroke-width: 3;
  }

  .capabilities-section {
    background: var(--paper-soft);
    padding: 0 0 clamp(2rem, 2.8vw, 2.8rem);
  }

  .capability-grid {
    position: relative;
    display: grid;
    min-height: 350px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(3.5rem, 7vw, 7rem);
  }

  .capability-grid::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--border);
    content: '';
  }

  .capability-grid + .capability-grid {
    margin-top: 0;
    border-top: 1px solid var(--border);
    padding-top: 0;
  }

  .capability-number {
    display: block;
    color: #72a900;
    font-family: var(--font-display);
    font-size: clamp(4rem, 6vw, 6rem);
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .capability-copy h2 {
    max-width: 560px;
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.2vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 1.02;
  }

  .lang-zh .capability-copy h2 {
    font-size: clamp(2.15rem, 3.35vw, 3.2rem);
    white-space: nowrap;
  }

  .capability-copy > p {
    max-width: 560px;
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.25vw, 1.13rem);
  }

  .capability-copy ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.8rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .capability-copy li {
    position: relative;
    padding-left: 1rem;
    color: #343934;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .capability-copy li::before {
    position: absolute;
    top: 0.63em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #72a900;
    content: '';
  }

  .capability-art {
    position: relative;
    display: grid;
    min-height: 290px;
    place-items: center;
  }

  .capability-art svg {
    position: relative;
    z-index: 1;
    width: min(100%, 360px);
    stroke: var(--text);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sound-ring {
    position: absolute;
    border: 1px solid rgba(114, 169, 0, 0.26);
    border-radius: 50%;
    animation: sound-breathe 4.2s ease-in-out infinite;
  }

  .sound-one { width: min(96%, 520px); height: 230px; }
  .sound-two { width: min(76%, 410px); height: 170px; animation-delay: -1.4s; }
  .sound-three { width: min(56%, 300px); height: 112px; animation-delay: -2.8s; }

  .timer-track {
    stroke: rgba(17, 19, 17, 0.2);
  }

  .timer-progress {
    stroke-width: 4;
    stroke-dasharray: 1;
    stroke-dashoffset: 0.24;
  }

  .timer-art text {
    fill: var(--text);
    stroke: none;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 30px;
    font-weight: 700;
  }

  .rhythm-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .rhythm-meta > div {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .meta-icon {
    display: grid;
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-size: 0.8rem;
  }

  .rhythm-meta strong,
  .rhythm-meta small {
    display: block;
  }

  .rhythm-meta strong {
    font-size: 0.83rem;
  }

  .rhythm-meta small {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .feature-panels {
    background: var(--paper-soft);
    padding: 0 0 clamp(2rem, 2.8vw, 2.8rem);
  }

  .desk-panel,
  .privacy-panel {
    display: grid;
    min-height: 250px;
    grid-template-columns: minmax(420px, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    overflow: hidden;
    border-radius: 28px;
    padding: clamp(1.8rem, 2.8vw, 2.8rem);
  }

  .desk-panel {
    border: 1px solid rgba(17, 19, 17, 0.76);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .desk-panel h2,
  .privacy-panel h2 {
    margin: 0;
