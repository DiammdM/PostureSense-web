<script>
  let cleanupFeaturesPage: (() => void) | null = null;

  const initializeFeaturesPage = () => {
    cleanupFeaturesPage?.();
    const root = document.documentElement;
    const page = document.querySelector<HTMLElement>('[data-features-page]');
    if (!page) {
      root.classList.remove('features-motion');
      cleanupFeaturesPage = null;
      return;
    }

    const targets = [...page.querySelectorAll<HTMLElement>('[data-features-reveal]')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.classList.add('features-motion');

    if (reduceMotion || !('IntersectionObserver' in window)) {
      targets.forEach((target) => target.classList.add('is-visible'));
      cleanupFeaturesPage = () => root.classList.remove('features-motion');
      return;
    }

    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        (entry.target as HTMLElement).classList.add('is-visible');
        currentObserver.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -7% 0px', threshold: 0.08 });

    targets.forEach((target) => observer.observe(target));
    cleanupFeaturesPage = () => {
      observer.disconnect();
      root.classList.remove('features-motion');
    };
  };

  document.addEventListener('astro:page-load', initializeFeaturesPage);
  document.addEventListener('astro:before-swap', () => cleanupFeaturesPage?.());
</script>
