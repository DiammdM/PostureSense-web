---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>

<style>
  .page-hero {
    padding: clamp(4.5rem, 10vw, 8rem) 0 clamp(3.5rem, 7vw, 6rem);
  }

  h1 {
    max-width: 930px;
    margin: 0;
    font-size: clamp(3rem, 9vw, 6.6rem);
    letter-spacing: -0.06em;
    line-height: 0.98;
    font-weight: 450;
  }

  .page-hero p:last-child {
    max-width: 760px;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
  }
</style>
