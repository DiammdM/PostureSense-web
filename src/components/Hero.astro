---
import { getLocaleFromPath, localizedPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const copy = {
  en: {
    titleLine1: 'When focus takes over,',
    titleLine2: 'don’t forget your body.',
    description: 'Let your iPhone gently remind you of sustained posture changes while you study, read, or work.',
    cta: 'How to download Posturely',
    productAlt: 'Posturely running on an iPhone placed on a desk stand',
  },
  zh: {
    titleLine1: '良好坐姿，',
    titleLine2: '可以很简单。',
    description: '学习、阅读或工作太投入时，Posturely 会轻轻提醒你留意坐姿。',
    cta: '如何下载 Posturely',
    productAlt: 'Posturely 在桌面支架上的 iPhone 中运行',
  },
  ja: {
    titleLine1: '集中するとき、',
    titleLine2: '体のことも忘れずに。',
    description: '勉強、読書、仕事中の大きな姿勢変化を、iPhone がやさしく知らせます。',
    cta: 'Posturely のダウンロード方法',
    productAlt: 'デスクスタンドの iPhone で動作する Posturely',
  },
}[locale];
---

<section class:list={['home-hero', `lang-${locale}`]} data-hero>
  <div class="hero-stage">
    <svg class="doodle reader" aria-hidden="true" viewBox="0 0 220 230" fill="none">
      <circle cx="100" cy="48" r="24"></circle><path d="M78 45c6-24 37-33 54-9M82 71c-21 16-30 52-25 90M119 74c23 24 26 60 20 93M60 161h90M75 111l25 15 31-18M100 126v30M51 174h113"></path>
      <path class="accent-stroke" d="M92 107 110 92l24 10-30 23-12-18Z"></path><path d="M72 174v31M145 174v31M39 205h125"></path>
    </svg>
    <svg class="doodle bell" aria-hidden="true" viewBox="0 0 100 100" fill="none">
      <path d="M72 50a22 22 0 0 0-44 0c0 24-12 24-12 31h68c0-7-12-7-12-31ZM43 89h14"></path><path class="accent-stroke" d="M81 28l9-8M87 43h11M72 18l3-12"></path>
    </svg>
    <svg class="doodle stand" aria-hidden="true" viewBox="0 0 120 140" fill="none">
      <rect x="39" y="10" width="43" height="78" rx="9" transform="rotate(-6 39 10)"></rect><path d="M58 89v27M25 129h73M39 116h39"></path><path class="accent-stroke" d="M88 22l12-8M92 35h16"></path>
    </svg>
    <svg class="doodle lock" aria-hidden="true" viewBox="0 0 80 90" fill="none">
      <rect x="14" y="36" width="52" height="43" rx="8"></rect><path d="M25 36V25a15 15 0 0 1 30 0v11"></path><circle class="accent-fill" cx="40" cy="57" r="5"></circle>
    </svg>

    <div class="hero-copy" data-hero-copy>
      <h1>{copy.titleLine1}<br />{copy.titleLine2}</h1>
      <p class="hero-description">{copy.description}</p>
      <a class="hero-cta" href={localizedPath('/download/', locale)}>{copy.cta} <span aria-hidden="true">→</span></a>
    </div>

    <figure class="hero-product" data-hero-product>
      <img src="/images/posturely-product-hero-real-app-v2.jpg" width="1536" height="1024" alt={copy.productAlt} loading="eager" fetchpriority="high" />
    </figure>
  </div>
</section>

<style>
  .home-hero { overflow: hidden; background: var(--paper); }
  .hero-stage { position: relative; display: grid; min-height: clamp(720px, 72vw, 900px); place-items: start center; overflow: hidden; padding: clamp(6rem, 10vw, 9rem) 24px 5rem; isolation: isolate; }
  .hero-copy { position: relative; z-index: 4; width: min(100%, 1040px); text-align: center; }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(3.2rem, 4.7vw, 5.1rem); font-weight: 400; letter-spacing: -.055em; line-height: .96; text-wrap: balance; }
  .lang-zh h1, .lang-ja h1 { letter-spacing: -.075em; line-height: 1.05; }
  .hero-description { max-width: 720px; margin: 2rem auto 0; color: var(--muted); font-size: clamp(1rem, 1.55vw, 1.22rem); line-height: 1.75; text-wrap: balance; }
  .hero-cta { display: inline-flex; min-height: 60px; align-items: center; justify-content: center; gap: .7rem; margin-top: 2.3rem; border-radius: 999px; background: var(--accent); padding: .8rem 2rem; color: var(--accent-ink); font-size: 1rem; font-weight: 760; box-shadow: inset 0 0 0 1px rgba(17,19,17,.08); transition: transform 180ms cubic-bezier(.22,1,.36,1), box-shadow 180ms ease; }
  .hero-cta span { transition: transform 180ms cubic-bezier(.22,1,.36,1); }
  .hero-cta:hover { transform: translateY(-3px); box-shadow: 0 12px 26px rgba(115,160,0,.16), inset 0 0 0 1px rgba(17,19,17,.1); }
  .hero-cta:hover span { transform: translateX(4px); }
  .hero-cta:active { transform: translateY(0) scale(.975); }
  .doodle { position: absolute; z-index: 2; stroke: var(--text); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .doodle .accent-stroke { stroke: var(--accent-text); }
  .doodle .accent-fill { fill: var(--accent); stroke: var(--text); }
  .reader { top: 24%; left: max(24px, 5vw); width: clamp(120px, 14vw, 210px); }
  .bell { top: 21%; right: max(36px, 12vw); width: clamp(64px, 7vw, 98px); }
  .stand { bottom: 8%; left: max(30px, 9vw); width: clamp(82px, 9vw, 120px); }
  .lock { right: max(34px, 25vw); bottom: 8%; width: clamp(56px, 6vw, 80px); }
  .hero-product { --hero-parallax: 0px; position: absolute; z-index: 3; right: max(-100px, -3vw); bottom: -1px; width: clamp(300px, 32vw, 520px); height: clamp(300px, 34vw, 520px); margin: 0; overflow: hidden; border-radius: 42% 0 0 0; background: var(--paper); mask-image: linear-gradient(90deg, transparent 0%, #000 24%, #000 100%); transform: translate3d(0,var(--hero-parallax),0); will-change: transform; }
  .hero-product img { width: 100%; height: 100%; object-fit: cover; object-position: 54% center; mix-blend-mode: multiply; transform: scale(1); transform-origin: 62% 55%; }
  :global(html.motion-ready) .hero-copy > * { transition: opacity 950ms cubic-bezier(.2,.65,.25,1), transform 950ms cubic-bezier(.2,.65,.25,1), filter 900ms ease; }
  :global(html.motion-ready) .home-hero:not(.is-entered) .hero-copy > * { opacity: 0; filter: blur(5px); transform: translateY(28px); }
  :global(html.motion-ready) .hero-copy > :nth-child(2) { transition-delay: 100ms; }
  :global(html.motion-ready) .hero-copy > :nth-child(3) { transition-delay: 180ms; }
  :global(html.motion-ready) .hero-copy > :nth-child(4) { transition-delay: 260ms; }
  :global(html.motion-ready) .doodle { transition: opacity 1050ms ease, transform 1050ms cubic-bezier(.2,.65,.25,1); }
  :global(html.motion-ready) .home-hero:not(.is-entered) .doodle { opacity: 0; transform: translateY(18px) scale(.96); }
  :global(html.motion-ready) .hero-product { transition: opacity 1200ms ease, transform 90ms linear; }
  :global(html.motion-ready) .hero-product img { transition: transform 1250ms cubic-bezier(.2,.65,.25,1); }
  :global(html.motion-ready) .home-hero:not(.is-entered) .hero-product { opacity: 0; transform: translate3d(0,calc(var(--hero-parallax) + 34px),0); }
  :global(html.motion-ready) .home-hero:not(.is-entered) .hero-product img { transform: scale(1.045); }
  :global(html.motion-ready) .home-hero.is-entered .reader { animation: reader-breathe 7s ease-in-out 1.4s infinite; }
  :global(html.motion-ready) .home-hero.is-entered .bell { animation: hero-bell 6.5s ease-in-out 2.4s infinite; transform-origin: 50% 20%; }
  @keyframes reader-breathe { 0%,100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-4px) rotate(-.6deg); } }
  @keyframes hero-bell { 0%,76%,100% { transform: rotate(0); } 80% { transform: rotate(-4deg); } 84% { transform: rotate(4deg); } 88% { transform: rotate(-2deg); } 92% { transform: rotate(0); } }
  @media (max-width: 1000px) {
    .hero-stage { min-height: 850px; }
    .reader { top: 29%; left: 2vw; opacity: .8; }
    .bell { top: 27%; right: 6vw; }
    .hero-product { width: 420px; height: 390px; }
    .lock { right: 46%; }
  }
  @media (max-width: 720px) {
    .hero-stage { min-height: 790px; padding-top: 4.5rem; }
    h1 { font-size: clamp(2.35rem, 10.2vw, 3.25rem); letter-spacing: -.08em; }
    .hero-description { max-width: 520px; }
    .reader, .lock { display: none; }
    .bell { top: 38%; right: 5vw; width: 58px; opacity: .7; }
    .stand { bottom: 3%; left: 5vw; width: 70px; }
    .hero-product { right: -115px; width: 390px; height: 355px; opacity: .93; }
  }
  @media (max-width: 480px) {
    .hero-stage { min-height: 730px; padding-inline: 18px; }
    .hero-description { font-size: .96rem; }
    .hero-cta { min-height: 54px; padding-inline: 1.4rem; }
    .hero-product { right: -90px; width: 350px; height: 310px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-copy > *, .doodle, .hero-product, .hero-product img { animation: none !important; transition: none !important; }
    .hero-product { --hero-parallax: 0px !important; transform: none !important; }
  }
</style>
