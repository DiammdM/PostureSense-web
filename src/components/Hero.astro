---
import HeroDownloadCard from './HeroDownloadCard.astro';
import ProductPreview from './ProductPreview.astro';
import { getLocaleFromPath, localizedPath } from '../i18n';
import { localizedContent } from '../data/localized';

const locale = getLocaleFromPath(Astro.url.pathname);
const englishHome = {
  eyebrow: 'Posture awareness for focused desk time',
  heroTitle: 'Your posture coach for iPhone.',
  heroDescription:
    'Place your iPhone on a desk stand and let Posturely monitor your upper-body posture while you study, read, or work. It reminds you when it detects head-down, forward-leaning, tilted, or noticeably changed posture.',
  howLink: 'See how it works',
};
const home = locale === 'en' ? englishHome : localizedContent[locale].home;
const values = {
  en: [
    ['Posture awareness', 'Notice meaningful changes during desk time.'],
    ['On-device processing', 'Camera frames stay on your iPhone or iPad.'],
    ['Gentle reminders', 'Choose sound or vibration that suits your focus.'],
  ],
  zh: [
    ['更自然的坐姿', '在桌面时间留意明显的坐姿变化。'],
    ['完全在设备本地', '摄像头画面仅在 iPhone 或 iPad 上处理。'],
    ['温和提醒', '使用适合专注环境的声音或震动提醒。'],
  ],
  ja: [
    ['自然な姿勢への気づき', 'デスク時間の大きな姿勢変化に気づく。'],
    ['デバイス上で処理', 'カメラフレームは iPhone・iPad 内で処理。'],
    ['やさしい通知', '集中に合う音または振動でお知らせ。'],
  ],
}[locale];
---

<section class:list={['hero', `lang-${locale}`]}>
  <div class="hero-frame hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{home.eyebrow}</p>
      <h1>
        {locale === 'zh' ? <>你的 iPhone<br />坐姿教练。</> : locale === 'ja' ? <>iPhone が、<br />姿勢コーチに。</> : home.heroTitle}
      </h1>
      <p class="lede">{home.heroDescription}</p>
      <div class="hero-actions">
        <HeroDownloadCard />
        <a class="text-link" href={localizedPath('/how-it-works/', locale)}>{home.howLink} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <ProductPreview />
  </div>
</section>

<section class="value-section">
  <div class="hero-frame value-strip" aria-label={locale === 'zh' ? 'Posturely 核心价值' : locale === 'ja' ? 'Posturely の主な特徴' : 'Posturely key benefits'}>
    {values.map(([title, description], index) => (
      <article>
        <span class="value-icon" aria-hidden="true">
          {index === 0 && <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="7"></circle><circle cx="12" cy="12" r="2"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg>}
          {index === 1 && <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 19 6v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6l7-3Z"></path><path d="m9 12 2 2 4-5"></path></svg>}
          {index === 2 && <svg viewBox="0 0 24 24" fill="none"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 8h18c0-1-3-1-3-8Z"></path><path d="M10 21h4"></path></svg>}
        </span>
        <div><h2>{title}</h2><p>{description}</p></div>
      </article>
    ))}
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: 0; isolation: isolate; }
  .hero::before { position: absolute; z-index: 0; top: 0; bottom: 0; left: 0; width: clamp(120px, 10vw, 190px); background: linear-gradient(155deg, var(--accent) 0%, #caff47 56%, #a7ed00 100%); clip-path: polygon(0 0, 34% 0, 100% 46%, 28% 100%, 0 100%); content: ""; }
  .hero::after { position: absolute; z-index: 1; top: 4.25rem; left: 1.75rem; width: 62px; height: 110px; background-image: radial-gradient(circle, rgba(17,19,17,.68) 1.35px, transparent 1.5px); background-size: 13px 13px; content: ""; }
  .hero-frame { width: calc(100% - 64px); max-width: 1760px; margin-inline: auto; }
  .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(500px, .82fr) minmax(620px, 1.18fr); align-items: stretch; gap: 0; }
  .hero-copy { position: relative; z-index: 3; display: flex; min-height: 650px; flex-direction: column; justify-content: center; padding: 2rem clamp(2rem, 3.5vw, 4rem) 3rem clamp(7rem, 11vw, 12rem); }
  h1 { max-width: 650px; margin: 0; font-size: clamp(4rem, 6vw, 6.4rem); font-weight: 480; letter-spacing: -.065em; line-height: .96; }
  .lang-zh h1, .lang-ja h1 { font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans", "Yu Gothic", sans-serif; font-size: clamp(3.2rem, 4.75vw, 5.15rem); font-weight: 580; letter-spacing: -.045em; line-height: 1.07; }
  .lede { max-width: 600px; margin: 1.7rem 0 0; color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.12rem); line-height: 1.75; }
  .hero-actions { display: flex; align-items: flex-end; gap: 1.6rem; margin-top: 2.1rem; }
  .text-link { color: var(--text); font-size: .94rem; font-weight: 720; white-space: nowrap; }
  .value-section { background: var(--bg); padding: 1.25rem 0 2.25rem; }
  .value-strip { position: relative; z-index: 4; display: grid; grid-template-columns: repeat(3, 1fr); overflow: hidden; border: 1px solid var(--border); border-radius: 18px; background: rgba(251,252,249,.96); }
  .value-strip article { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1rem; padding: 1.35rem clamp(1rem, 2.5vw, 2rem); }
  .value-strip article + article { border-left: 1px solid var(--border); }
  .value-icon { display: grid; width: 46px; height: 46px; place-items: center; border-radius: 50%; background: color-mix(in srgb, var(--accent) 62%, white); color: var(--text); }
  .value-icon svg { width: 23px; height: 23px; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .value-strip h2 { margin: 0; font-size: .98rem; font-weight: 760; letter-spacing: -.02em; }
  .value-strip p { margin: .15rem 0 0; color: var(--muted); font-size: .75rem; line-height: 1.45; }
  @media (max-width: 1180px) { .hero::before, .hero::after { display: none; } .hero-frame { width: calc(100% - 40px); max-width: var(--max-width); } .hero-grid { grid-template-columns: 1fr; } .hero-copy { min-height: auto; padding: 4.5rem 0 1rem; } h1 { max-width: 780px; } }
  @media (max-width: 720px) { .value-strip { grid-template-columns: 1fr; } .value-strip article + article { border-top: 1px solid var(--border); border-left: 0; } }
  @media (max-width: 540px) { .hero { padding-top: 2.5rem; } h1, .lang-zh h1, .lang-ja h1 { font-size: clamp(2.85rem, 13.5vw, 4rem); } .hero-actions { align-items: stretch; flex-direction: column; gap: 1rem; } .text-link { padding: .45rem 0; text-align: center; } }
</style>
