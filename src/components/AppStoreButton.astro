---
import { getLocaleFromPath, localizedPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const label = {
  en: 'View download guide',
  zh: '查看下载说明',
  ja: 'ダウンロード方法を見る',
}[locale];
---

<a
  class="app-store-button"
  href={localizedPath('/download/', locale)}
  aria-label={label}
>
  <span class="label">{label} <span aria-hidden="true">→</span></span>
</a>

<style>
  .app-store-button {
    display: inline-flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border-radius: 14px;
    background: var(--text);
    color: #fff;
    padding: 0.62rem 1.2rem 0.68rem;
    font-weight: 760;
    line-height: 1.05;
    transition: transform 160ms ease, background 160ms ease;
  }

  .app-store-button:hover {
    transform: translateY(-2px);
    background: #2a2d2a;
  }

  .small {
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .label {
    margin-top: 0.25rem;
    font-size: 1rem;
  }

</style>
