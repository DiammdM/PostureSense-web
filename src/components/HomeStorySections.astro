  @media (max-width: 680px) {
    .center-heading h2, .uses-heading h2, .faq-layout h2, .signals-heading h2, .privacy-copy h2 { font-size: clamp(2.25rem,9.5vw,3.4rem); }
    .step-copy h3 { font-size: clamp(2rem,9vw,2.7rem); }
    .step-list { gap: 5rem; }
    .step-visual { min-height: 300px; }
    .signals-stage { grid-template-columns: 1fr; }
    .pose-map { grid-column: 1; grid-row: 1; max-width: 390px; margin-inline: auto; }
    .signal-list.left, .signal-list.right { grid-column: 1; grid-row: auto; grid-template-columns: 1fr; gap: 1.5rem; }
    .use-pills { gap: 1rem; }
    .use-pills article { min-width: 100%; }
    .privacy-section::before { left: -70px; width: 110px; }
    .privacy-copy { padding: 5rem 24px 5rem 48px; }
    .secure-flow { width: 23%; }
    .flow-left { left: 14%; }
    .flow-right { right: 14%; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal], .step-visual *, .pose-map *, .privacy-diagram *, .faq-list details p, .use-pills article { animation: none !important; transition: none !important; }
    [data-reveal] { opacity: 1 !important; filter: none !important; transform: none !important; }
    .step-visual .draw-line, .step-visual .signal-strokes, .step-visual .timer-progress { stroke-dashoffset: 0 !important; }
    .timer-live-dot { opacity: 1 !important; transform: none !important; }
    .secure-flow { transform: scaleX(1) !important; }
  }
</style>

<script>
  let cleanupHomeMotion: (() => void) | null = null;

  const initializeHomeMotion = () => {
    cleanupHomeMotion?.();

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.documentElement;
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const heroProduct = document.querySelector<HTMLElement>('[data-hero-product]');
    const revealTargets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];

    if (!hero && revealTargets.length === 0) {
      root.classList.remove('motion-ready');
      cleanupHomeMotion = null;
      return;
    }

    const timerTimeouts: number[] = [];
    let revealObserver: IntersectionObserver | null = null;
    let entranceFrame = 0;
    let enteredFrame = 0;
    let parallaxFrame = 0;
    let removeParallaxListener: (() => void) | null = null;

    revealTargets.forEach((target) => {
      const delay = target.dataset.revealDelay;
      if (delay) target.style.setProperty('--reveal-delay', `${Math.round(Number(delay))}ms`);
    });

    root.classList.add('motion-ready');
    entranceFrame = requestAnimationFrame(() => {
      enteredFrame = requestAnimationFrame(() => hero?.classList.add('is-entered'));
    });

    const startTimer = (scene: HTMLElement) => {
      if (scene.dataset.timerStarted === 'true') return;
      scene.dataset.timerStarted = 'true';
      scene.classList.add('is-timer-running');

      const timerText = scene.querySelector<SVGTextElement>('[data-timer-text]');
      if (!timerText) return;

      timerTimeouts.push(window.setTimeout(() => { timerText.textContent = '39:59'; }, 280));
      timerTimeouts.push(window.setTimeout(() => { timerText.textContent = '39:58'; }, 560));
    };

    if (reduceMotion || !('IntersectionObserver' in window)) {
      revealTargets.forEach((target) => target.classList.add('is-visible'));
    } else {
      revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const target = entry.target as HTMLElement;
          target.classList.add('is-visible');
          if (target.hasAttribute('data-timer-scene')) startTimer(target);
          observer.unobserve(target);
        });
      }, { rootMargin: '0px 0px -2% 0px', threshold: 0.05 });

      revealTargets.forEach((target) => revealObserver?.observe(target));
    }

    if (!reduceMotion && hero && heroProduct) {
      const updateHeroParallax = () => {
        const progress = Math.min(1, Math.max(0, window.scrollY / Math.max(hero.offsetHeight, 1)));
        heroProduct.style.setProperty('--hero-parallax', `${progress * -18}px`);
        parallaxFrame = 0;
      };
      const requestHeroParallax = () => {
        if (parallaxFrame) return;
        parallaxFrame = requestAnimationFrame(updateHeroParallax);
      };
      updateHeroParallax();
      window.addEventListener('scroll', requestHeroParallax, { passive: true });
      removeParallaxListener = () => window.removeEventListener('scroll', requestHeroParallax);
    }

    cleanupHomeMotion = () => {
      revealObserver?.disconnect();
      removeParallaxListener?.();
      timerTimeouts.forEach((timeout) => window.clearTimeout(timeout));
      if (entranceFrame) cancelAnimationFrame(entranceFrame);
      if (enteredFrame) cancelAnimationFrame(enteredFrame);
      if (parallaxFrame) cancelAnimationFrame(parallaxFrame);
    };
  };

  document.addEventListener('astro:page-load', initializeHomeMotion);
  document.addEventListener('astro:before-swap', () => cleanupHomeMotion?.());
</script>
