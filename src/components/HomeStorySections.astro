    .signals-stage { grid-template-columns: 1fr 1.1fr; }
    .signal-list.right { grid-column: 1; grid-row: 2; }
    .pose-map { grid-column: 2; grid-row: 1 / span 2; }
    .privacy-section { grid-template-columns: 1fr; }
    .privacy-diagram { min-height: 360px; }
    .faq-layout { grid-template-columns: 1fr; gap: 3rem; }
