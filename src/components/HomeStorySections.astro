---
import { getLocaleFromPath, localizedPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const copy = {
  en: {
    howTitle: 'Three simple steps to start a session', howIntro: 'From placing your device to receiving a reminder, every step is clear and simple.', howLink: 'See the full guide',
    steps: [
      ['Place your iPhone', 'Set your iPhone or iPad on a stable desk stand where your upper body is clearly visible.'],
      ['Start monitoring', 'Choose a session length, establish a reference posture, then return your attention to what matters.'],
      ['Receive a gentle reminder', 'When a sustained head-down, forward-leaning, or tilted change is detected, receive a sound or vibration reminder.'],
    ],
    signalsEyebrow: 'Posture awareness', signalsTitle: 'What Posturely notices', signalsIntro: 'Posturely compares sustained visible changes with the reference established for your current session.', signalsLink: 'Explore all features',
    signals: [['Head down', 'Head position continues moving downward.'], ['Leaning forward', 'Upper body continues moving forward.'], ['Body tilt', 'Upper body tilts noticeably to either side.'], ['Posture change', 'Posture differs from the session reference.']],
    usesEyebrow: 'Desk time', usesTitle: 'Made for moments of focus', usesIntro: 'Bring quiet posture awareness into the desk moments that matter to you.',
    uses: [['Studying', 'Stay aware during focused study.'], ['Reading', 'Notice sustained changes during longer reading.'], ['Writing', 'Keep your attention on the page.'], ['Desk work', 'Fit awareness into everyday tasks.'], ['Long computer sessions', 'Add gentle reminders to extended screen time.']],
    privacyEyebrow: 'Privacy by design', privacyTitle: 'Camera frames stay on your device', privacyBody: 'Camera frames used for posture detection are processed locally on your iPhone or iPad and are never uploaded to any server.', privacyLink: 'Learn about privacy',
    faqEyebrow: 'Frequently asked questions', faqTitle: 'About Posturely', faqLink: 'View all questions',
    faqs: [['What is Posturely?', 'Posturely is an iPhone and iPad app for posture awareness during focused desk time.'], ['How does Posturely detect posture?', 'It observes visible upper-body changes during an active session and compares them with that session’s reference posture.'], ['Does Posturely upload camera footage?', 'No. Camera frames used for posture detection are processed locally on the device.']],
  },
  zh: {
    howTitle: '简单三步，开始监督。', howIntro: '从放好设备到获得提醒，整个过程清楚而简单。', howLink: '查看完整工作原理',
    steps: [
      ['放好你的手机', '将设备放在稳定的桌面支架上，确保上半身清晰可见。'],
      ['开始监督', '选择监督时长，建立本次参考姿态，然后专注于眼前的事情。'],
      ['坐姿变化时获得提醒', '检测到持续的低头、前倾或倾斜后，通过声音或震动温和提醒。'],
    ],
    signalsEyebrow: '坐姿觉察', signalsTitle: 'Posturely 会留意什么', signalsIntro: '坐姿发生明显变化时，Posturely 会轻轻提醒你。', signalsLink: '查看全部功能',
    signals: [['低头', '头部位置持续向下移动。'], ['身体前倾', '上半身持续向前移动。'], ['身体倾斜', '上半身出现明显左右倾斜。'], ['明显坐姿变化', '坐姿偏离本次监督的参考姿态。']],
    usesEyebrow: '桌面时刻', usesTitle: '适合这些专注时刻', usesIntro: '学习、阅读、写作或工作时，让坐姿觉察自然融入专注。',
    uses: [['学习', '专注投入时留意持续变化。'], ['阅读', '长时间阅读时获得温和提醒。'], ['写作', '让注意力继续留在纸面。'], ['桌面办公', '把坐姿觉察融入日常任务。'], ['长时间使用电脑', '在持续屏幕时间中获得适时提醒。']],
    privacyEyebrow: '隐私设计', privacyTitle: '画面留在设备里', privacyBody: '用于坐姿检测的摄像头画面仅在 iPhone 或 iPad 本地处理，不会上传到任何服务器。', privacyLink: '了解隐私设计',
    faqEyebrow: '常见问题', faqTitle: '关于 Posturely', faqLink: '查看全部常见问题',
    faqs: [['Posturely 是什么？', 'Posturely 是一款用于专注桌面时间坐姿觉察的 iPhone 和 iPad App。'], ['Posturely 如何检测坐姿？', '监督期间，Posturely 会观察可见的上半身变化，并与本次监督建立的参考姿态进行比较。'], ['摄像头画面会上传吗？', '不会。用于坐姿检测的摄像头画面仅在设备本地处理。']],
  },
  ja: {
    howTitle: '3 ステップでモニタリングを開始。', howIntro: 'デバイスの設置から通知まで、シンプルでわかりやすい流れです。', howLink: '詳しい使い方を見る',
    steps: [
      ['iPhone を置く', '上半身がはっきり見えるよう、安定したデスクスタンドに置きます。'],
      ['モニタリングを開始', '時間を選び、今回の基準姿勢を設定したら、目の前のことに集中します。'],
      ['変化したら通知', 'うつむき、前傾、傾きが続くと、音または振動でやさしく知らせます。'],
    ],
    signalsEyebrow: '姿勢への気づき', signalsTitle: 'Posturely が気づく変化', signalsIntro: 'セッションの基準姿勢と比べ、継続して見られる大きな変化に気づきます。', signalsLink: 'すべての機能を見る',
    signals: [['うつむき', '頭の位置が下へ移動し続けます。'], ['前傾', '上半身が前へ移動し続けます。'], ['体の傾き', '上半身が左右へ大きく傾きます。'], ['姿勢の変化', 'セッションの基準から姿勢が変わります。']],
    usesEyebrow: 'デスク時間', usesTitle: '集中するデスク時間に', usesIntro: '勉強、読書、創作、仕事に、静かな姿勢への気づきを。',
    uses: [['勉強', '集中しながら姿勢の変化にも気づく。'], ['読書', '長い読書時間にやさしく通知。'], ['書く時間', '注意を紙面に向けたまま。'], ['デスクワーク', '日々の作業に自然に取り入れる。'], ['長時間のパソコン作業', '長い画面時間にも適切に通知。']],
    privacyEyebrow: 'プライバシー設計', privacyTitle: 'カメラ映像はデバイス内に', privacyBody: '姿勢検出用のカメラフレームは iPhone または iPad 上で処理され、いかなるサーバーにもアップロードされません。', privacyLink: 'プライバシー設計を見る',
    faqEyebrow: 'よくある質問', faqTitle: 'Posturely について', faqLink: 'すべての質問を見る',
    faqs: [['Posturely とは？', '集中するデスク時間の姿勢への気づきを支える iPhone・iPad アプリです。'], ['姿勢をどのように検出しますか？', 'セッション中に見える上半身の変化を、そのセッションで設定した姿勢と比較します。'], ['カメラ映像をアップロードしますか？', 'いいえ。姿勢検出用のフレームはデバイス上で処理されます。']],
  },
}[locale];
---

<div class:list={['home-story', `lang-${locale}`]}>
  <section class="steps-section" aria-labelledby="steps-title">
    <div class="container">
      <header class="center-heading" data-reveal>
        <h2 id="steps-title">{copy.howTitle}</h2>
        <p>{copy.howIntro}</p>
        <a class="section-link" href={localizedPath('/how-it-works/', locale)}>{copy.howLink} <span aria-hidden="true">→</span></a>
      </header>
      <ol class="step-list">
        {copy.steps.map(([title, description], index) => (
          <li class:list={['step-row', { reverse: index % 2 === 1 }]}>
            <div class:list={['step-visual', `step-visual-${index + 1}`]} aria-hidden="true" data-reveal data-step-scene={index + 1} data-timer-scene={index === 1 ? '' : undefined}>
              {index === 0 && <svg viewBox="0 0 280 280" fill="none"><rect class="draw-line" pathLength="1" x="94" y="30" width="88" height="148" rx="19" transform="rotate(-5 94 30)"></rect><path class="draw-line" pathLength="1" d="M132 181v44M62 246h158M91 225h85"></path><path class="accent-line signal-strokes" pathLength="1" d="M193 55l27-16M203 80h35"></path></svg>}
              {index === 1 && <svg viewBox="0 0 280 280" fill="none"><rect x="86" y="24" width="108" height="190" rx="22"></rect><circle class="timer-track" cx="140" cy="115" r="48"></circle><path class="accent-line timer-progress" pathLength="1" d="M140 67a48 48 0 1 1-35 81"></path><path d="M123 41h34M127 231h26"></path><text data-timer-text x="140" y="125" text-anchor="middle">40:00</text><circle class="timer-live-dot" cx="140" cy="177" r="4"></circle></svg>}
              {index === 2 && <svg viewBox="0 0 300 280" fill="none"><g class="reminder-bell"><path d="M218 90a34 34 0 0 0-68 0c0 40-20 40-20 51h108c0-11-20-11-20-51ZM170 155h28"></path></g><circle cx="92" cy="76" r="28"></circle><path d="M68 105c-21 26-23 65-20 112M112 108c25 25 31 63 25 108M57 222h94"></path><path class="accent-line sound-wave sound-wave-one" d="M238 57l20-16"></path><path class="accent-line sound-wave sound-wave-two" d="M246 82h30"></path></svg>}
            </div>
            <div class="step-copy" data-reveal data-reveal-delay="90">
              <p class="step-label"><i aria-hidden="true"></i>{String(index + 1).padStart(2, '0')}</p>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="signals-section" aria-labelledby="signals-title">
    <div class="container signals-inner">
      <header class="signals-heading" data-reveal>
        <p class="eyebrow">{copy.signalsEyebrow}</p>
        <h2 id="signals-title">{copy.signalsTitle}</h2>
        <p>{copy.signalsIntro}</p>
        <a class="dark-link" href={localizedPath('/features/', locale)}>{copy.signalsLink} <span aria-hidden="true">→</span></a>
      </header>
      <div class="signals-stage">
        <div class="signal-list left">
          {copy.signals.slice(0, 2).map(([title, description], index) => <article data-reveal data-reveal-delay={80 + index * 90}><i aria-hidden="true"></i><div><h3>{title}</h3><p>{description}</p></div></article>)}
        </div>
        <div class="pose-map" aria-hidden="true" data-reveal>
          <img
            class="pose-illustration"
            src="/images/home-posture-awareness-scene-v1-800.webp"
            srcset="/images/home-posture-awareness-scene-v1-800.webp 800w, /images/home-posture-awareness-scene-v1.webp 1536w"
            sizes="(max-width: 720px) 390px, (max-width: 1000px) 50vw, 620px"
            width="1536"
            height="1024"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="signal-list right">
          {copy.signals.slice(2).map(([title, description], index) => <article data-reveal data-reveal-delay={160 + index * 90}><i aria-hidden="true"></i><div><h3>{title}</h3><p>{description}</p></div></article>)}
        </div>
      </div>
    </div>
  </section>

  <section class="uses-section" aria-labelledby="uses-title">
    <div class="container">
      <header class="uses-heading" data-reveal>
        <p class="eyebrow">{copy.usesEyebrow}</p>
        <h2 id="uses-title">{copy.usesTitle}</h2>
        <p>{copy.usesIntro}</p>
      </header>
      <div class="use-pills">
        {copy.uses.map(([title, description], index) => <article data-reveal data-reveal-delay={index * 70}><i aria-hidden="true"></i><div><h3>{title}</h3><p>{description}</p></div></article>)}
      </div>
      <svg class="uses-doodle book" aria-hidden="true" viewBox="0 0 120 90" fill="none"><path d="M12 16c22-8 35-2 48 12v50C47 65 34 60 12 68V16ZM108 16c-22-8-35-2-48 12v50c13-13 26-18 48-10V16Z"></path></svg>
      <svg class="uses-doodle pencil" aria-hidden="true" viewBox="0 0 100 100" fill="none"><path d="m20 74 9-31 42-35 20 20-42 35-29 11ZM29 43l20 20M20 74l18-5-13-13-5 18Z"></path></svg>
    </div>
  </section>

  <section class="privacy-section" aria-labelledby="privacy-title">
    <div class="privacy-copy" data-reveal>
      <p class="eyebrow">{copy.privacyEyebrow}</p>
      <h2 id="privacy-title">{copy.privacyTitle}</h2>
      <p>{copy.privacyBody}</p>
      <a href={localizedPath('/privacy/', locale)}>{copy.privacyLink} <span aria-hidden="true">→</span></a>
    </div>
    <div class="privacy-diagram" aria-hidden="true" data-reveal data-privacy-scene>
      <svg class="device" viewBox="0 0 80 110" fill="none"><rect x="19" y="8" width="42" height="78" rx="9"></rect><path d="M40 86v12M22 103h36"></path></svg>
      <span class="secure-flow flow-left"></span>
      <span class="secure-lock"></span>
      <span class="secure-flow flow-right"></span>
      <svg class="device" viewBox="0 0 80 110" fill="none"><rect x="19" y="8" width="42" height="84" rx="9"></rect><path d="M34 15h12"></path></svg>
    </div>
  </section>

  <section class="faq-section" aria-labelledby="faq-title">
    <div class="container faq-layout">
      <header data-reveal>
        <p class="eyebrow">{copy.faqEyebrow}</p>
        <h2 id="faq-title">{copy.faqTitle}</h2>
        <a class="section-link" href={localizedPath('/faq/', locale)}>{copy.faqLink} <span aria-hidden="true">→</span></a>
      </header>
      <div class="faq-list" data-reveal data-reveal-delay="100">
        {copy.faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}
      </div>
    </div>
  </section>

</div>

<style>
  .home-story h2, .home-story h3 { font-family: var(--font-display); font-weight: 400; }
  :global(html.motion-ready) [data-reveal] { opacity: 0; filter: blur(5px); transform: translateY(30px); transition: opacity 1050ms cubic-bezier(.2,.65,.25,1) var(--reveal-delay,0ms), transform 1050ms cubic-bezier(.2,.65,.25,1) var(--reveal-delay,0ms), filter 950ms ease var(--reveal-delay,0ms); }
  :global(html.motion-ready) [data-reveal].is-visible { opacity: 1; filter: none; transform: translateY(0); }
  .steps-section { background: var(--paper-soft); padding: clamp(6rem, 11vw, 10rem) 0; }
  .center-heading { max-width: 820px; margin: 0 auto; text-align: center; }
  .center-heading h2, .uses-heading h2, .faq-layout h2, .signals-heading h2, .privacy-copy h2 { margin: 0; font-size: clamp(2.5rem, 4.4vw, 4.5rem); letter-spacing: -.055em; line-height: 1.02; }
  .center-heading > p:not(.eyebrow), .uses-heading > p:not(.eyebrow) { max-width: 650px; margin: 1.3rem auto 0; color: var(--muted); }
  .section-link, .dark-link { display: inline-flex; align-items: center; gap: .5rem; margin-top: 1.5rem; border-bottom: 1px solid currentColor; padding-bottom: .2rem; font-size: .82rem; font-weight: 760; }
  .section-link span, .dark-link span, .privacy-copy > a span { transition: transform 180ms cubic-bezier(.22,1,.36,1); }
  .section-link:hover span, .dark-link:hover span, .privacy-copy > a:hover span { transform: translateX(4px); }
  .step-list { display: grid; gap: clamp(6rem, 10vw, 10rem); margin: clamp(5rem, 9vw, 8rem) 0 0; padding: 0; list-style: none; }
  .step-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .85fr); align-items: center; gap: clamp(3rem, 10vw, 10rem); }
  .step-row.reverse .step-visual { grid-column: 2; }
  .step-row.reverse .step-copy { grid-column: 1; grid-row: 1; }
  .step-visual { display: grid; min-height: 430px; place-items: center; border-radius: 44% 56% 52% 48% / 46% 43% 57% 54%; background: var(--paper-blob); }
  .step-visual svg { width: min(72%, 370px); stroke: var(--text); stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; }
  .step-visual .accent-line { stroke: var(--accent-text); }
  .step-visual text { fill: var(--text); stroke: none; font-family: ui-monospace, monospace; font-size: 22px; font-weight: 700; }
  .step-visual .draw-line, .step-visual .signal-strokes { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .step-visual.is-visible .draw-line { animation: draw-stroke 650ms cubic-bezier(.22,1,.36,1) 100ms forwards; }
  .step-visual.is-visible .signal-strokes { animation: draw-stroke 400ms cubic-bezier(.22,1,.36,1) 420ms forwards; }
  .timer-track { opacity: .28; }
  .step-visual .timer-progress { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .step-visual.is-timer-running .timer-progress { animation: draw-stroke 850ms cubic-bezier(.22,1,.36,1) 100ms forwards; }
  .timer-live-dot { fill: var(--accent); stroke: var(--text); stroke-width: 1.5; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .step-visual.is-timer-running .timer-live-dot { animation: timer-dot 650ms ease 650ms 2; }
  .step-visual.is-timer-running text { animation: timer-number 320ms cubic-bezier(.22,1,.36,1) 2; }
  .reminder-bell { transform-box: fill-box; transform-origin: 50% 10%; }
  .step-visual.is-visible .reminder-bell { animation: reminder-ring 760ms cubic-bezier(.22,1,.36,1) 220ms both; }
  .sound-wave { opacity: 0; transform-box: fill-box; transform-origin: left center; }
  .step-visual.is-visible .sound-wave-one { animation: sound-wave 620ms ease-out 400ms both; }
  .step-visual.is-visible .sound-wave-two { animation: sound-wave 620ms ease-out 500ms both; }
  @keyframes draw-stroke { to { stroke-dashoffset: 0; } }
  @keyframes timer-dot { 0%,100% { opacity: .35; transform: scale(.7); } 50% { opacity: 1; transform: scale(1.45); } }
  @keyframes timer-number { 0%,100% { opacity: 1; transform: translateY(0); } 48% { opacity: 0; transform: translateY(-5px); } 52% { opacity: 0; transform: translateY(5px); } }
  @keyframes reminder-ring { 0%,100% { transform: rotate(0); } 25% { transform: rotate(-5deg); } 45% { transform: rotate(5deg); } 65% { transform: rotate(-3deg); } 82% { transform: rotate(2deg); } }
  @keyframes sound-wave { 0% { opacity: 0; transform: translateX(-7px) scale(.75); } 35% { opacity: 1; } 100% { opacity: 0; transform: translateX(12px) scale(1.18); } }
  .step-label { display: inline-flex; width: fit-content; align-items: center; gap: .55rem; margin: 0 0 1.5rem; border: 1px solid var(--border-strong); border-radius: 999px; padding: .45rem .8rem; font-size: .75rem; font-weight: 720; }
  .step-label i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .step-copy h3 { margin: 0; font-size: clamp(2.2rem, 3.5vw, 3.8rem); letter-spacing: -.05em; line-height: 1.04; }
  .step-copy > p:last-child { max-width: 520px; margin: 1.3rem 0 0; color: var(--muted); font-size: clamp(.95rem, 1.4vw, 1.1rem); }
  .signals-section { overflow: hidden; background: var(--dark); color: var(--paper); padding: clamp(6rem, 10vw, 9rem) 0 4rem; }
  .signals-heading { max-width: 900px; }
  .signals-heading .eyebrow { color: var(--accent); }
  .signals-heading > p:not(.eyebrow) { max-width: 650px; margin: 1.3rem 0 0; color: rgba(248,247,241,.58); }
  .dark-link { color: var(--accent); }
  .signals-stage { display: grid; grid-template-columns: minmax(220px,.8fr) minmax(320px,1.15fr) minmax(220px,.8fr); align-items: center; gap: clamp(1rem,4vw,4rem); margin-top: 4rem; }
  .signal-list { display: grid; gap: clamp(2rem,5vw,5rem); }
  .signal-list article { display: grid; grid-template-columns: 42px 1fr; gap: 1rem; }
  .signal-list i { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid rgba(248,247,241,.2); border-radius: 50%; }
  .signal-list i::after { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px rgba(184,255,25,.1); content: ''; }
  .signal-list h3 { margin: 0; font-family: inherit; font-size: 1.06rem; font-weight: 700; }
  .signal-list p { margin: .45rem 0 0; color: rgba(248,247,241,.55); font-size: .78rem; }
  .pose-map { position: relative; display: grid; min-width: 0; place-items: center; }
  .pose-illustration { display: block; width: min(126%, 620px); max-width: none; height: auto; object-fit: contain; }
  .uses-section { position: relative; overflow: hidden; background: var(--paper); padding: clamp(6rem,10vw,9rem) 0; }
  .uses-heading { max-width: 820px; }
  .uses-heading > p:not(.eyebrow) { margin-left: 0; }
  .use-pills { display: flex; max-width: 1120px; flex-wrap: wrap; justify-content: center; gap: 1.5rem; margin: clamp(3.5rem,7vw,6rem) auto 0; }
  .use-pills article { display: flex; min-width: min(100%, 270px); flex: 1 1 270px; align-items: center; gap: 1rem; border: 1px solid var(--border-strong); border-radius: 999px; padding: 1.2rem 1.6rem; background: rgba(255,255,255,.3); }
  .use-pills article.is-visible:hover { background: rgba(255,255,255,.62); box-shadow: 0 12px 30px rgba(17,19,17,.06); transform: translateY(-3px); }
  .use-pills i { width: 10px; height: 10px; flex: 0 0 10px; border-radius: 50%; background: var(--accent); }
  .use-pills h3 { margin: 0; font-family: inherit; font-size: 1.02rem; font-weight: 700; }
  .use-pills p { margin: .15rem 0 0; color: var(--muted); font-size: .72rem; }
  .uses-doodle { position: absolute; width: 90px; stroke: var(--text); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; opacity: .7; }
  .uses-doodle.book { top: 4rem; right: 5vw; } .uses-doodle.pencil { bottom: 2rem; left: 3vw; width: 70px; }
  .privacy-section { position: relative; display: grid; grid-template-columns: 1fr 1fr; min-height: 560px; overflow: hidden; background: var(--dark); color: var(--paper); }
  .privacy-section::before { position: absolute; top: -15%; left: -90px; width: 170px; height: 130%; border-radius: 0 55% 45% 0; background: var(--accent); content: ''; }
  .privacy-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(4rem,8vw,8rem) clamp(3rem,8vw,8rem) clamp(4rem,8vw,8rem) max(72px, calc((100vw - var(--max-width))/2)); }
  .privacy-copy h2 { font-size: clamp(2.5rem,4.4vw,4.5rem); }
  .privacy-copy .eyebrow { color: var(--accent); }
  .privacy-copy > p:not(.eyebrow) { max-width: 620px; margin: 1.5rem 0 0; color: rgba(248,247,241,.65); }
  .privacy-copy > a { width: fit-content; margin-top: 1.5rem; border: 1px solid rgba(248,247,241,.4); border-radius: 999px; padding: .65rem 1rem; font-size: .82rem; font-weight: 700; }
  .privacy-diagram { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; place-items: center; overflow: hidden; }
  .privacy-diagram::before, .privacy-diagram::after { position: absolute; width: 360px; height: 360px; border: 1px solid rgba(184,255,25,.16); border-radius: 50%; content: ''; }
  .privacy-diagram::after { width: 220px; height: 220px; }
  .privacy-diagram .device { position: relative; z-index: 1; width: 78px; stroke: rgba(248,247,241,.72); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .secure-flow { position: absolute; z-index: 0; top: 50%; width: 25%; height: 1px; overflow: visible; background: linear-gradient(90deg, rgba(184,255,25,.08), rgba(184,255,25,.72)); transform: scaleX(0); }
  .secure-flow::after { position: absolute; top: -3px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 16px rgba(184,255,25,.55); content: ''; opacity: 0; }
  .flow-left { left: 18%; transform-origin: left center; }
  .flow-left::after { left: 0; }
  .flow-right { right: 18%; background: linear-gradient(270deg, rgba(184,255,25,.08), rgba(184,255,25,.72)); transform-origin: right center; }
  .flow-right::after { right: 0; }
  .privacy-diagram.is-visible .secure-flow { animation: secure-line 520ms cubic-bezier(.22,1,.36,1) 160ms forwards; }
  .privacy-diagram.is-visible .flow-left::after { animation: secure-dot-left 650ms ease-in-out 360ms both; }
  .privacy-diagram.is-visible .flow-right::after { animation: secure-dot-right 650ms ease-in-out 430ms both; }
  .secure-lock { position: relative; z-index: 2; width: 58px; height: 50px; border-radius: 7px; background: var(--accent); box-shadow: 0 0 0 28px rgba(184,255,25,.06); }
  .secure-lock::before { position: absolute; width: 28px; height: 27px; border: 6px solid var(--accent); border-bottom: 0; border-radius: 15px 15px 0 0; content: ''; transform: translate(9px,-20px); }
  .privacy-diagram.is-visible .secure-lock { animation: lock-settle 460ms cubic-bezier(.22,1,.36,1) 720ms both; }
  .privacy-diagram.is-visible .secure-lock::before { animation: lock-close 380ms cubic-bezier(.22,1,.36,1) 620ms both; }
  @keyframes secure-line { to { transform: scaleX(1); } }
  @keyframes secure-dot-left { 0% { opacity: 0; transform: translateX(0); } 20% { opacity: 1; } 85% { opacity: 1; } 100% { opacity: 0; transform: translateX(180px); } }
  @keyframes secure-dot-right { 0% { opacity: 0; transform: translateX(0); } 20% { opacity: 1; } 85% { opacity: 1; } 100% { opacity: 0; transform: translateX(-180px); } }
  @keyframes lock-close { from { transform: translate(17px,-18px) rotate(28deg); transform-origin: 4px 25px; } to { transform: translate(9px,-20px) rotate(0); transform-origin: center; } }
  @keyframes lock-settle { 0% { box-shadow: 0 0 0 0 rgba(184,255,25,.2); transform: scale(.9); } 60% { box-shadow: 0 0 0 36px rgba(184,255,25,.07); transform: scale(1.06); } 100% { box-shadow: 0 0 0 28px rgba(184,255,25,.06); transform: scale(1); } }
  .faq-section { background: var(--paper); padding: clamp(6rem,10vw,9rem) 0; }
  .faq-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem,10vw,10rem); }
  .faq-list details { border-top: 1px solid var(--border); }
  .faq-list details:last-child { border-bottom: 1px solid var(--border); }
  .faq-list summary { display: flex; cursor: pointer; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.65rem 0; font-size: 1rem; font-weight: 700; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { font-size: 1.5rem; font-weight: 400; transition: transform 150ms ease; }
  .faq-list details[open] summary span { transform: rotate(45deg); }
  .faq-list details p { margin: -.35rem 0 1.6rem; color: var(--muted); }
  .faq-list details[open] p { animation: faq-answer 320ms cubic-bezier(.22,1,.36,1) both; }
  @keyframes faq-answer { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 900px) {
    .step-row { grid-template-columns: 1fr; gap: 2.5rem; }
