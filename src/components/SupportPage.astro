---
interface Props {
  locale: 'en' | 'zh' | 'ja';
  eyebrow: string;
  heading: string;
  headingLines?: readonly string[];
  intro: string;
  browseTitle: string;
  steps: readonly string[];
  items: readonly (readonly [string, string])[];
  contactEyebrow: string;
  contactTitle: string;
  contactText: string;
  emailLabel: string;
  emailHref: string;
}

const {
  locale,
  eyebrow,
  heading,
  headingLines,
  intro,
  browseTitle,
  steps,
  items,
  contactEyebrow,
  contactTitle,
  contactText,
  emailLabel,
  emailHref,
} = Astro.props;

const icons = ['camera', 'stand', 'light', 'bag', 'restore'] as const;
---

<article class={`support-page lang-${locale}`}>
  <svg class="icon-sprite" aria-hidden="true">
    <defs>
      <symbol id="support-icon-stand" viewBox="0 0 64 64">
        <rect x="23" y="7" width="22" height="37" rx="5"></rect>
        <path d="M28 12h12M26 44l-9 9h31M32 44v9"></path>
      </symbol>
      <symbol id="support-icon-shield" viewBox="0 0 64 64">
        <path d="M32 6 52 14v16c0 13-8 23-20 29C20 53 12 43 12 30V14Z"></path>
        <path d="m23 31 6 6 13-14"></path>
      </symbol>
      <symbol id="support-icon-play" viewBox="0 0 64 64">
        <circle cx="32" cy="32" r="23"></circle>
        <path d="m28 23 14 9-14 9Z"></path>
      </symbol>
      <symbol id="support-icon-camera" viewBox="0 0 64 64">
        <path d="M10 19h11l4-6h14l4 6h11v30H10Z"></path>
        <circle cx="32" cy="34" r="10"></circle>
        <path d="M15 24h4"></path>
      </symbol>
      <symbol id="support-icon-light" viewBox="0 0 64 64">
        <circle cx="32" cy="32" r="13"></circle>
        <path d="M32 4v10M32 50v10M4 32h10M50 32h10M12 12l7 7M45 45l7 7M52 12l-7 7M19 45l-7 7"></path>
      </symbol>
      <symbol id="support-icon-bag" viewBox="0 0 64 64">
        <path d="M12 21h40l-2 35H14Z"></path>
        <path d="M23 22v-5c0-6 3-10 9-10s9 4 9 10v5"></path>
      </symbol>
      <symbol id="support-icon-restore" viewBox="0 0 64 64">
        <path d="M51 22A23 23 0 0 0 12 17l-5 7"></path>
        <path d="M7 12v12h12M13 42a23 23 0 0 0 39 5l5-7"></path>
        <path d="M57 52V40H45"></path>
      </symbol>
    </defs>
  </svg>

  <section class="support-hero">
    <div class="support-container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-page-reveal>{eyebrow}</p>
        <h1 data-page-reveal data-page-delay="80">{headingLines ? headingLines.map((line) => <span class="heading-line">{line}</span>) : heading}</h1>
        <p class="hero-intro" data-page-reveal data-page-delay="160">{intro}</p>
      </div>

      <div class="hero-visual" aria-hidden="true" data-page-reveal="scale" data-page-delay="100">
        <img
          src="/images/support-hero-illustration-v3.webp"
          srcset="/images/support-hero-illustration-v3-768.webp 768w, /images/support-hero-illustration-v3.webp 1464w"
          sizes="(max-width: 780px) 92vw, 55vw"
          alt=""
          width="1464"
          height="1014"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <div class="support-container">
    <ol class="setup-strip" aria-label={steps.join(', ')}>
      {steps.map((step, index) => (
        <li data-page-reveal data-page-delay={index * 70}>
          <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
          <svg aria-hidden="true"><use href={`#support-icon-${index === 0 ? 'stand' : index === 1 ? 'shield' : 'play'}`}></use></svg>
          <strong>{step}</strong>
          {index < steps.length - 1 && <span class="step-arrow" aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>
  </div>

  <section class="topics-section">
    <div class="support-container">
      <h2 class="topics-title" data-page-reveal>{browseTitle}</h2>

      <div class="topics-layout">
        {items[0] && (
          <article class="featured-topic" id="support-topic-1" data-page-reveal="scale">
            <span class="topic-number">01</span>
            <h3>{items[0][0]}</h3>
            <p>{items[0][1]}</p>
            <img
              class="featured-art"
              src="/images/support-featured-topic-illustration-v1.webp"
              srcset="/images/support-featured-topic-illustration-v1-768.webp 768w, /images/support-featured-topic-illustration-v1.webp 1023w"
              sizes="(max-width: 780px) 92vw, 40vw"
              width="1023"
              height="1538"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </article>
        )}

        <div class="topic-list">
          {items.slice(1).map(([title, description], index) => (
            <article class="topic-row" id={`support-topic-${index + 2}`} data-page-reveal data-page-delay={Math.min(index * 60, 180)}>
              <div class="topic-icon" aria-hidden="true">
                <svg><use href={`#support-icon-${icons[index]}`}></use></svg>
              </div>
              <div class="topic-copy">
                <span class="topic-number">{String(index + 2).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <section class="support-contact" aria-labelledby="support-contact-title" data-page-reveal="scale">
        <div>
          <p class="contact-eyebrow">{contactEyebrow}</p>
          <h2 id="support-contact-title">{contactTitle}</h2>
          <p>{contactText}</p>
        </div>
        <a href={emailHref}>{emailLabel}<span aria-hidden="true">↗</span></a>
      </section>
    </div>
  </section>
</article>

<style>
  .support-page { flex: 1 0 auto; overflow: hidden; background: var(--paper); }
  .support-container { width: min(calc(100% - 48px), 1260px); margin-inline: auto; }
  .icon-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  .support-hero { padding: clamp(4.5rem, 8vw, 7.5rem) 0 clamp(2rem, 4vw, 3.5rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(520px, 1.18fr); align-items: center; gap: clamp(3rem, 6vw, 6rem); }
  .hero-copy h1 { max-width: 540px; margin: 0; font-family: var(--font-display); font-size: clamp(3rem, 4.2vw, 4.2rem); font-weight: 400; letter-spacing: -.07em; line-height: .98; }
  .heading-line { display: block; white-space: nowrap; }
  .lang-en .hero-copy h1 { font-size: clamp(2.75rem, 4.3vw, 4.5rem); }
  .lang-ja .hero-copy h1 { font-size: clamp(2.4rem, 2.9vw, 2.65rem); line-height: 1.04; }
  .hero-intro { max-width: 480px; margin: 2rem 0 0; color: var(--muted); font-size: clamp(.98rem, 1.35vw, 1.15rem); line-height: 1.75; }
  .hero-visual { overflow: hidden; border-radius: 20px; background: #0b0f0c; box-shadow: 0 24px 60px rgba(17,19,17,.1); }
  .hero-visual img { display: block; width: 100%; height: auto; }
  .setup-strip { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; border: 1px solid var(--border); border-radius: 18px; background: rgba(255,255,255,.5); padding: 0; list-style: none; }
  .setup-strip li { position: relative; display: grid; min-height: 110px; grid-template-columns: auto 46px 1fr auto; align-items: center; gap: 1rem; padding: 1.25rem 2rem; }
  .setup-strip svg { width: 42px; height: 42px; fill: none; stroke: var(--text); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .setup-strip strong { font-size: 1.06rem; letter-spacing: -.02em; }
  .step-number { display: grid; width: 36px; height: 36px; place-items: center; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-size: .72rem; font-weight: 800; }
  .step-arrow { padding-left: .5rem; font-size: 1.6rem; font-weight: 300; }
  .topics-section { padding: clamp(3rem, 4.5vw, 4.5rem) 0 clamp(7rem, 11vw, 11rem); }
  .topics-title { margin: 0 0 1.8rem; font-family: var(--font-display); font-size: clamp(2.7rem, 4.2vw, 4rem); font-weight: 400; letter-spacing: -.055em; line-height: 1; }
  .topics-layout { display: grid; grid-template-columns: minmax(330px, .76fr) minmax(0, 1.24fr); gap: 1rem; }
  .featured-topic, .topic-row { border: 1px solid var(--border); }
  .featured-topic { position: relative; min-height: 760px; overflow: hidden; border-color: rgba(17,19,17,.55); border-radius: 18px; background: #f8f5ef; padding: 2.2rem; }
  .topic-row { background: rgba(255,255,255,.44); }
  .topic-number { color: var(--accent-text); font-size: .74rem; font-weight: 800; }
  .featured-topic h3 { margin: .7rem 0 0; font-family: var(--font-display); font-size: clamp(2.2rem, 3vw, 3.5rem); font-weight: 400; letter-spacing: -.05em; line-height: 1.05; }
  .featured-topic > p { max-width: 360px; margin: 1rem 0 0; color: var(--muted); font-size: .96rem; }
  .featured-topic > .topic-number, .featured-topic > h3, .featured-topic > p { position: relative; z-index: 1; }
  .featured-art { position: absolute; right: -1px; bottom: -52px; left: -1px; display: block; width: calc(100% + 2px); height: auto; }
  .topic-list { display: grid; gap: 1rem; }
  .topic-row { display: grid; min-height: 139px; grid-template-columns: 92px 1fr; align-items: center; gap: 1.15rem; border-radius: 16px; padding: 1.35rem 1.5rem; }
  .topic-icon { display: grid; width: 74px; height: 74px; place-items: center; }
  .topic-icon svg { width: 58px; height: 58px; fill: none; stroke: var(--text); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .topic-copy h3 { margin: .15rem 0 0; font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.15; letter-spacing: -.03em; }
  .topic-copy p { max-width: 620px; margin: .4rem 0 0; color: var(--muted); font-size: .86rem; line-height: 1.55; }
  .support-contact { display: grid; min-height: 240px; grid-template-columns: 1fr minmax(280px, .7fr); align-items: center; gap: 4rem; margin-top: clamp(3rem, 6vw, 5rem); border-radius: 18px; background: #0b0f0c; padding: clamp(2rem, 5vw, 4rem); color: var(--paper); }
  .contact-eyebrow { margin: 0 0 .5rem; color: var(--accent); font-size: .75rem; font-weight: 800; letter-spacing: .08em; }
  .support-contact h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2.5rem, 4.8vw, 4.6rem); font-weight: 400; letter-spacing: -.055em; line-height: 1; }
  .support-contact div > p:last-child { max-width: 610px; margin: 1rem 0 0; color: rgba(248,245,239,.6); font-size: .88rem; }
  .support-contact a { display: flex; min-height: 62px; align-items: center; justify-content: center; gap: 2rem; border-radius: 8px; background: var(--accent); color: var(--accent-ink); font-size: .95rem; font-weight: 800; transition: background 170ms ease, transform 170ms ease; }
  .support-contact a:hover { background: #c6ff46; transform: translateY(-2px); }
  @media (max-width: 1000px) {
    .hero-grid { grid-template-columns: .86fr 1.14fr; gap: 2rem; }
    .hero-copy h1 { font-size: clamp(3rem, 5.8vw, 4.2rem); }
    .setup-strip li { grid-template-columns: auto 38px 1fr; padding: 1rem; }
    .setup-strip svg { width: 34px; height: 34px; }
    .step-arrow { display: none; }
    .topics-layout { grid-template-columns: .8fr 1.2fr; }
    .topic-row { grid-template-columns: 62px 1fr; gap: .75rem; padding: 1.1rem; }
    .topic-icon { width: 58px; height: 58px; }
    .topic-icon svg { width: 48px; height: 48px; }
  }
  @media (max-width: 780px) {
    .support-container { width: min(calc(100% - 32px), 1260px); }
    .support-hero { padding-top: 3.5rem; }
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy h1, .lang-en .hero-copy h1, .lang-ja .hero-copy h1 { max-width: 640px; font-size: clamp(2.75rem, 10.5vw, 4.2rem); }
    .hero-intro { margin-top: 1.25rem; }
    .hero-visual { margin-top: 1rem; border-radius: 16px; }
    .setup-strip { grid-template-columns: 1fr; }
    .setup-strip li { min-height: 82px; grid-template-columns: 36px 42px 1fr; border-bottom: 1px solid var(--border); }
    .setup-strip li:last-child { border-bottom: 0; }
    .topics-layout { grid-template-columns: 1fr; }
    .featured-topic { min-height: 680px; }
    .featured-art { bottom: -42px; }
    .topic-row { min-height: 128px; }
    .support-contact { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 500px) {
    .support-hero { padding-top: 2.8rem; }
    .hero-copy h1, .lang-en .hero-copy h1, .lang-ja .hero-copy h1 { font-size: clamp(2.25rem, 11vw, 3.4rem); }
    .lang-ja .hero-copy h1 { font-size: clamp(1.85rem, 8.8vw, 2.6rem); }
    .hero-visual { margin-inline: -5px; }
    .setup-strip strong { font-size: .95rem; }
    .topics-section { padding-top: 3.8rem; }
    .topics-title { font-size: 2.6rem; }
    .featured-topic { min-height: 590px; padding: 1.5rem; }
    .featured-art { bottom: -28px; }
    .featured-topic h3 { font-size: 2.4rem; }
    .topic-row { grid-template-columns: 48px 1fr; gap: .65rem; padding: 1rem .9rem; }
    .topic-icon { width: 44px; height: 44px; }
    .topic-icon svg { width: 42px; height: 42px; }
    .topic-copy p { font-size: .79rem; }
    .support-contact { padding: 1.6rem; }
    .support-contact h2 { font-size: 2.7rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .support-contact a { transition: none; }
  }
</style>
