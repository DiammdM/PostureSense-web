---
import { supportContent as content } from '../data/support';

const email = 'diammd@icloud.com';
const emailHref = `mailto:${email}?subject=${encodeURIComponent(content.title)}`;
---

<article class="support-page" lang="zh-Hans">
  <div class="support-document">
    <header class="support-intro">
      <h1>{content.title}</h1>
      <p>{content.intro}</p>
    </header>

    <section class="support-section contact-section" aria-labelledby="support-contact-title">
      <h2 id="support-contact-title">{content.contact.title}</h2>
      <div class="section-content">
        <p>{content.contact.intro}</p>
        <ul>
          {content.contact.items.map((item, index) => (
            <li>
              {index === 0
                ? <>{item.slice(0, item.indexOf(email))}<a href={emailHref}>{email}</a></>
                : item}
            </li>
          ))}
        </ul>
        <p>{content.contact.outro}</p>
      </div>
    </section>

    <section class="support-section" aria-labelledby="support-faq-title">
      <h2 id="support-faq-title">{content.faq.title}</h2>
      <div class="section-content questions">
        {content.faq.items.map((item, index) => (
          <section class="question" aria-labelledby={`support-question-${index + 1}`}>
            <h3 id={`support-question-${index + 1}`}>{item.question}</h3>
            {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {'list' in item && <ul>{item.list.map((entry) => <li>{entry}</li>)}</ul>}
          </section>
        ))}
      </div>
    </section>

    <section class="support-section scope-section" aria-labelledby="support-scope-title">
      <h2 id="support-scope-title">{content.scope.title}</h2>
      <div class="section-content">
        <p>{content.scope.text}</p>
      </div>
    </section>
  </div>
</article>

<style>
  .support-page { flex: 1 0 auto; background: var(--paper-soft); }
  .support-document { width: min(calc(100% - 48px), 1080px); margin-inline: auto; padding: clamp(2.5rem, 5vw, 5rem) 0 clamp(4rem, 7vw, 7rem); }
  .support-intro { max-width: 820px; padding-bottom: clamp(2rem, 4vw, 3rem); }
  .support-intro h1 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 600; letter-spacing: var(--heading-tracking, -.025em); line-height: 1.3; }
  .support-intro p { max-width: 760px; margin: 1.4rem 0 0; color: var(--muted); font-size: 1.05rem; line-height: 1.85; }
  .support-section { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); margin-top: 3rem; }
  .support-section h2 { margin: 0; font-size: 1.4rem; font-weight: 650; letter-spacing: -.02em; line-height: 1.5; }
  .section-content { min-width: 0; }
  .section-content p { margin: 0; color: var(--muted); line-height: 1.85; }
  .section-content p + p { margin-top: .75rem; }
  .section-content ul { margin: 1rem 0; padding-left: 1.3rem; list-style: disc; color: var(--muted); }
  .section-content li { padding-left: .25rem; line-height: 1.85; }
  .section-content li + li { margin-top: .5rem; }
  .contact-section { margin-top: 0; border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 12px; background: var(--surface); padding: 2rem; }
  .contact-section a { color: var(--accent-text); text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .contact-section a:hover { color: var(--text); }
  .question { border-bottom: 1px solid var(--border); padding: 0 0 1.8rem; }
  .question + .question { padding-top: 1.8rem; }
  .question h3 { margin: 0 0 .75rem; font-size: 1.15rem; font-weight: 650; line-height: 1.55; }
  .question ul:last-child { margin-bottom: 0; }
  .scope-section { padding-top: 2rem; border-top: 1px solid var(--border); }
  @media (max-width: 760px) {
    .support-document { width: min(calc(100% - 32px), 620px); }
    .support-section { grid-template-columns: 1fr; gap: 1.25rem; margin-top: 2.5rem; }
    .contact-section { margin-top: 0; padding: 1.4rem; }
    .support-intro p { font-size: 1rem; }
    .support-section h2 { font-size: 1.3rem; }
  }
</style>
