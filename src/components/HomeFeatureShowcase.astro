---
import { getLocaleFromPath, localizedPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const copy = {
  en: {
    title: 'Designed for focus. Built around privacy.',
    intro: 'Simple, thoughtful tools that work quietly while your attention stays on what matters.', more: 'Learn more',
    items: [
      ['Posture change detection', 'Notice head-down, forward-leaning, tilted, and noticeably changed posture during an active session.'],
      ['On-device processing', 'Camera frames used for posture detection are processed locally and are not uploaded to Posturely servers.'],
      ['Gentle reminders', 'Choose sound or vibration and adjust sensitivity to suit your desk setup and focus environment.'],
    ],
  },
  zh: {
    title: '为专注而设计的核心功能',
    intro: '简洁、智能、尊重隐私。Posturely 在后台安静工作，让你专注于真正重要的事情。', more: '了解更多',
    items: [
      ['坐姿变化检测', '通过 iPhone 摄像头感知头部与躯干姿态变化。'],
      ['本地处理，保护隐私', '所有计算均在设备本地完成，不上传，不共享。'],
      ['温和提醒', '自定义提醒间隔与方式，在需要时温和出现。'],
    ],
  },
  ja: {
    title: '集中のために設計し、プライバシーを大切に。',
    intro: 'シンプルで控えめな機能が静かに動き、大切なことへの集中を支えます。', more: '詳しく見る',
    items: [
      ['姿勢変化の検出', 'セッション中のうつむき、前傾、傾き、その他の大きな姿勢変化を検出します。'],
      ['オンデバイス処理', '姿勢検出用のカメラフレームはデバイス上で処理され、サーバーへアップロードされません。'],
      ['やさしい通知', 'デスク環境に合わせて音や振動を選び、検出感度を調整できます。'],
    ],
  },
}[locale];
---

<section class="home-features" aria-labelledby="core-features-title">
  <div class="container showcase-layout">
    <div class="showcase-intro">
      <h2 id="core-features-title">{locale === 'zh' ? <>为专注而设计的<br />核心功能</> : copy.title}</h2>
      <p>{copy.intro}</p>
    </div>
    <div class="showcase-grid">
      {copy.items.map(([title, description], index) => (
        <article class="showcase-card">
          <span class="icon" aria-hidden="true">
            {index === 0 && <svg viewBox="0 0 32 32" fill="none"><path d="M6 9V5h4M22 5h4v4M26 23v4h-4M10 27H6v-4"></path><path d="m9 22 5-6 4 3 5-8"></path><circle cx="9" cy="22" r="1.5"></circle><circle cx="14" cy="16" r="1.5"></circle><circle cx="18" cy="19" r="1.5"></circle><circle cx="23" cy="11" r="1.5"></circle></svg>}
            {index === 1 && <svg viewBox="0 0 32 32" fill="none"><rect x="7" y="13" width="18" height="15" rx="2"></rect><path d="M11 13V9a5 5 0 0 1 10 0v4"></path></svg>}
            {index === 2 && <svg viewBox="0 0 32 32" fill="none"><path d="M24 13a8 8 0 0 0-16 0c0 9-4 9-4 11h24c0-2-4-2-4-11Z"></path><path d="M13 28h6"></path></svg>}
          </span>
          <div class="card-copy">
            <h3>{title}</h3>
            <p>{description}</p>
            <a href={localizedPath('/features/', locale)}>{copy.more} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .home-features { position: relative; overflow: hidden; border-block: 1px solid var(--border); background: var(--surface); }
  .home-features::before { position: absolute; z-index: 0; top: 0; right: 0; width: clamp(90px, 12vw, 180px); height: 100%; background: var(--accent); clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%, 27% 78%, 27% 17%); content: ""; }
  .home-features::after { position: absolute; z-index: 0; top: 3.5rem; right: 2rem; width: 58px; height: 58px; background-image: radial-gradient(circle, rgba(17,19,17,.78) 1.4px, transparent 1.5px); background-size: 13px 13px; content: ""; }
  .showcase-layout { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(320px, 1.1fr) minmax(0, 2.75fr); align-items: stretch; }
  .showcase-intro { display: flex; flex-direction: column; justify-content: center; padding: clamp(2.25rem, 4vw, 3.5rem) clamp(1rem, 2vw, 2rem) clamp(2.25rem, 4vw, 3.5rem) 0; }
  .showcase-intro h2 { max-width: 420px; margin: 0; font-size: clamp(2rem, 2.1vw, 2.4rem); font-weight: 540; letter-spacing: -.05em; line-height: 1.04; }
  .showcase-intro > p:last-child { max-width: 360px; margin: 1.35rem 0 0; color: var(--muted); font-size: .88rem; line-height: 1.65; }
  .showcase-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-self: stretch; margin-top: 2rem; border: 1px solid var(--border); border-bottom: 0; border-radius: 10px 10px 0 0; background: rgba(251,252,249,.97); }
  .showcase-card { display: grid; min-width: 0; grid-template-columns: 56px minmax(0, 1fr); gap: .75rem; padding: clamp(2rem, 3vw, 3rem) clamp(1rem, 1.2vw, 1.25rem) 2.25rem; }
  .showcase-card + .showcase-card { border-left: 1px solid var(--border); }
  .icon { display: grid; width: 56px; height: 82px; place-items: start center; }
  .icon svg { width: 54px; height: 54px; stroke: currentColor; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; }
  .showcase-card:first-child .icon circle { fill: var(--accent); }
  .showcase-card:nth-child(2) .icon rect { fill: color-mix(in srgb, var(--accent) 85%, white); }
  .card-copy { display: flex; min-width: 0; flex-direction: column; }
  .showcase-card h3 { margin: .2rem 0 0; font-size: 1rem; letter-spacing: -.02em; }
  .showcase-card p { margin: .7rem 0 1.5rem; color: var(--muted); font-size: .78rem; line-height: 1.6; }
  .showcase-card a { width: fit-content; margin-top: auto; border-bottom: 2px solid var(--accent); padding-bottom: .2rem; font-size: .78rem; font-weight: 740; }
  @media (max-width: 960px) { .showcase-layout { grid-template-columns: 1fr; } .showcase-intro { padding: 3.5rem 0 2.5rem; } .showcase-intro h2, .showcase-intro > p:last-child { max-width: 680px; } .showcase-grid { margin-top: 0; } }
  @media (max-width: 820px) { .home-features::before, .home-features::after { display: none; } .showcase-grid { grid-template-columns: 1fr; margin-bottom: 3rem; border-bottom: 1px solid var(--border); border-radius: 10px; } .showcase-card + .showcase-card { border-top: 1px solid var(--border); border-left: 0; } .showcase-card { min-height: 230px; } }
  @media (max-width: 540px) { .showcase-intro { padding: 3rem 0 2rem; } .showcase-intro h2 { max-width: 330px; font-size: clamp(2.45rem, 12vw, 3.25rem); } .showcase-card { grid-template-columns: 62px minmax(0, 1fr); gap: 1rem; padding: 1.75rem 1.25rem; } .icon { width: 62px; } .icon svg { width: 54px; height: 54px; } }
</style>
