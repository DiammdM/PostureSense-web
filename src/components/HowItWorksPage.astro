<script>
  let cleanupHowItWorks: (() => void) | null = null;

  const initializeHowItWorks = () => {
    cleanupHowItWorks?.();
    const root = document.documentElement;
    const page = document.querySelector<HTMLElement>('[data-hiw]');
    if (!page) {
      root.classList.remove('hiw-motion');
      cleanupHowItWorks = null;
      return;
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealTargets = [...page.querySelectorAll<HTMLElement>('[data-hiw-reveal]')];
    const intervals: number[] = [];
    let observer: IntersectionObserver | null = null;
    root.classList.add('hiw-motion');

    const startTimer = (target: HTMLElement) => {
      if (target.dataset.timerStarted === 'true') return;
      target.dataset.timerStarted = 'true';
      const label = target.querySelector<SVGTextElement>('[data-hiw-timer-text]');
      if (!label || reduceMotion) return;
      let elapsed = 0;
      const interval = window.setInterval(() => {
        elapsed += 1;
        label.textContent = `39:${String(60 - elapsed).padStart(2, '0')}`;
        if (elapsed >= 5) window.clearInterval(interval);
      }, 900);
      intervals.push(interval);
    };

    if (reduceMotion || !('IntersectionObserver' in window)) {
      revealTargets.forEach((target) => target.classList.add('is-visible'));
    } else {
      observer = new IntersectionObserver((entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const target = entry.target as HTMLElement;
          target.classList.add('is-visible');
          if (target.hasAttribute('data-hiw-timer')) startTimer(target);
          currentObserver.unobserve(target);
        });
      }, { rootMargin: '0px 0px -6% 0px', threshold: .08 });
      revealTargets.forEach((target) => observer?.observe(target));
    }

    cleanupHowItWorks = () => {
      observer?.disconnect();
      intervals.forEach((interval) => window.clearInterval(interval));
      root.classList.remove('hiw-motion');
    };
  };

  document.addEventListener('astro:page-load', initializeHowItWorks);
  document.addEventListener('astro:before-swap', () => cleanupHowItWorks?.());
</script>
