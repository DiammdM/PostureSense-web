---
import { getLocaleFromPath } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const copy = {
  en: {
    eyebrow: 'How it works',
    title: 'Set down your phone. Start a simple posture session.',
    titleLines: ['Set down your phone.', 'Start a simple', 'posture session.'],
    intro: 'Keep your upper body in view, choose a session length, then return your attention to what matters.',
    checks: ['Stable desk stand', 'Upper body clearly visible', 'Choose a session length'],
    journey: 'One session, four moments',
    steps: [
      ['Place your phone', 'Set your phone on a stable desk stand.'],
      ['Bring your upper body into view', 'Adjust the angle so your head, shoulders, and upper body are visible.'],
      ['Start monitoring', 'Choose a length, establish this session’s reference, then continue studying or working.'],
      ['Receive a gentle reminder', 'If your posture keeps changing, Posturely can gently alert you with sound or vibration.'],
    ],
    privacyTitle: 'Camera frames stay on your device',
    privacyBody: 'Camera frames are processed locally on your device and are not uploaded to any server.',
  },
  zh: {
    eyebrow: '工作原理',
    title: '放好手机，开始一次轻松的坐姿监督。',
    titleLines: ['放好手机，', '开始一次轻松的', '坐姿监督。'],
    intro: '让上半身出现在画面中，选择时长，然后专注于眼前的事情。',
    checks: ['稳定支架', '上半身清晰可见', '选择监督时长'],
    journey: '一次监督，四个时刻',
    steps: [
      ['放好手机', '把手机放在稳定的桌面支架上。'],
      ['让上半身进入画面', '调整角度，让头部、肩膀和上半身都能被看到。'],
      ['开始监督', '选择时长，建立本次参考，然后继续学习或工作。'],
      ['坐姿变化时获得提醒', '坐姿持续变化时，Posturely 会通过声音或震动轻轻提醒你。'],
    ],
    privacyTitle: '画面留在设备里',
    privacyBody: '摄像头画面只在设备本地处理，不会上传到任何服务器。',
  },
  ja: {
    eyebrow: '使い方',
    title: 'スマートフォンを置いて、気軽に姿勢モニタリングを。',
    titleLines: ['スマートフォンを置いて、', '気軽に姿勢', 'モニタリングを。'],
    intro: '上半身が画面に入るようにして時間を選んだら、目の前のことに集中できます。',
    checks: ['安定したスタンド', '上半身が見える', '時間を選択'],
    journey: '1 回のセッション、4 つの場面',
    steps: [
      ['スマートフォンを置く', '安定したデスクスタンドにスマートフォンを置きます。'],
      ['上半身を画面に入れる', '頭、肩、上半身が見えるように角度を調整します。'],
      ['モニタリングを開始', '時間を選び、今回の基準を設定したら、勉強や仕事を続けます。'],
      ['姿勢が変わったら通知', '姿勢の変化が続くと、音や振動でやさしく知らせます。'],
    ],
    privacyTitle: 'カメラ映像はデバイス内に',
    privacyBody: 'カメラ映像はデバイス上で処理され、いかなるサーバーにもアップロードされません。',
  },
}[locale];
---

<article class:list={['hiw-page', `lang-${locale}`]} data-hiw>
  <section class="hiw-hero">
    <div class="container hiw-hero-grid">
      <div class="hiw-hero-content">
        <div class="hiw-hero-copy">
          <p class="eyebrow" data-page-reveal>{copy.eyebrow}</p>
          <h1 aria-label={copy.title} data-page-reveal data-page-delay="80">{copy.titleLines.map((line) => <span>{line}</span>)}</h1>
          <p class="hiw-intro" data-page-reveal data-page-delay="160">{copy.intro}</p>
        </div>

        <ul class="hiw-checks" aria-label={copy.eyebrow} data-page-reveal data-page-delay="240">
          {copy.checks.map((item) => <li><i aria-hidden="true">✓</i><span>{item}</span></li>)}
        </ul>
      </div>

      <div class="hiw-hero-scene" data-page-reveal="scale" data-page-delay="100" aria-hidden="true">
        <svg viewBox="0 0 560 460" fill="none">
          <path class="scene-faint" d="M385 63v254M414 63v254M453 177c13-38 39-63 67-68-1 39-24 70-66 81M456 193c35-26 68-25 89-10-20 34-51 49-91 33M485 213v94M451 307h69M55 370h460"></path>
          <path class="scene-faint" d="M92 334c63 7 118 5 176-5M429 352l100 9M430 365l100 9M457 345l-5 25"></path>
          <rect class="scene-paper" x="421" y="326" width="112" height="34" rx="3" transform="rotate(6 421 326)"></rect>
          <path d="M175 326h158M220 326l-2-46M304 326l-5-47M229 275c14 8 51 8 64-1"></path>
          <path d="M211 266 272 266 318 369H151l60-103Z"></path>
          <circle cx="288" cy="264" r="24"></circle><circle cx="288" cy="264" r="14"></circle>
          <path d="M289 279c20 18 27 38 28 64M303 326h45M187 362h167"></path>
          <rect class="hero-phone" x="154" y="39" width="153" height="239" rx="29" transform="rotate(4 154 39)"></rect>
          <path d="m204 54 50 3M182 257l95 7"></path>
          <circle class="timer-ring" cx="230" cy="162" r="50"></circle>
          <text class="timer-value" x="230" y="154" text-anchor="middle">40:00</text>
          <text class="timer-label" x="230" y="185" text-anchor="middle">{locale === 'zh' ? '开始' : locale === 'ja' ? '開始' : 'START'}</text>
          <path class="art-accent" d="M340 104c12 2 20 7 25 15M344 91l11-8M364 102l13-2"></path>
        </svg>
        <div class="hiw-reference-art hero-reference">
          <img src="/images/how-it-works/hero.webp" width="366" height="300" alt="" loading="eager" decoding="async" fetchpriority="high" draggable="false" />
        </div>
      </div>

    </div>
  </section>

  <section class="hiw-journey" aria-labelledby="journey-title">
    <div class="container">
      <header class="hiw-journey-heading" data-hiw-reveal>
        <h2 id="journey-title">{copy.journey}</h2>
        <i aria-hidden="true"></i>
      </header>

      <div class="hiw-flow">
        <article class="hiw-step hiw-step-one" data-hiw-reveal>
          <div class="hiw-step-copy">
            <span>01</span><h3>{copy.steps[0][0]}</h3><p>{copy.steps[0][1]}</p>
          </div>
          <svg class="step-art stand-art" viewBox="0 0 520 290" fill="none" aria-hidden="true">
            <path class="art-soft" d="M362 38c23 37 24 78 4 113M413 46c-8 47-3 83 22 111M404 159v63M374 222h62M343 239h105M438 238h50M447 222l7 16M459 222l7 16M471 222l7 16"></path>
            <path class="art-soft" d="M377 81c9-23 24-37 42-42-1 24-15 42-39 49M381 92c22-14 42-13 55-3-12 20-31 28-54 18"></path>
            <rect class="phone-screen" x="207" y="34" width="91" height="151" rx="20" transform="rotate(-7 207 34)"></rect>
            <path d="m239 47 29-4M253 185v17M249 202l-32 46M261 203l30 44M217 248h75M232 258h46"></path>
            <circle cx="255" cy="199" r="10"></circle>
            <path class="art-accent" d="m305 67 20-16M311 88h28M201 75c-9 6-12 17-8 27M189 70c-15 11-20 29-13 45"></path>
            <path class="desk-line" d="M54 264h420"></path>
          </svg>
          <div class="hiw-reference-art step-one-reference" aria-hidden="true"><img src="/images/how-it-works/step1.webp" width="330" height="190" alt="" loading="lazy" decoding="async" draggable="false" /></div>
        </article>

        <article class="hiw-step hiw-step-two" data-hiw-reveal>
          <div class="hiw-step-copy">
            <span>02</span><h3>{copy.steps[1][0]}</h3><p>{copy.steps[1][1]}</p>
          </div>
          <svg class="step-art frame-art" viewBox="0 0 560 330" fill="none" aria-hidden="true">
            <path class="art-soft" d="M438 78h92M438 116h92M452 78v38M486 78v38M517 78v38M462 65h12M493 61h18M450 233h84M463 198c8-21 21-34 37-39-1 23-13 40-36 48M467 210c19-13 39-12 50-3-11 18-28 26-49 16M490 222v24"></path>
            <rect x="37" y="132" width="61" height="98" rx="13"></rect><path d="M67 231v35M38 282h61M49 266h38M96 156l42-16"></path>
            <path d="M112 138c14-7 27-8 40-3M118 148c11-5 21-5 31-1"></path>
            <path class="frame-corner" d="M234 53h-31v31M393 53h31v31M234 280h-31v-31M393 280h31v-31"></path>
            <path d="M286 94c4-34 66-39 80-5M290 93c13-22 61-29 76 0"></path>
            <circle cx="329" cy="111" r="39"></circle><path d="M279 282c1-61 8-96 29-125M383 282c-2-62-9-96-31-125M301 160c19 17 39 18 57 0M328 159v68M287 282h89"></path>
            <path d="M276 216l-45 27M346 216l38 24M233 242h70M384 240l35 18M300 241l47 3"></path>
            <path class="art-accent scan-line" d="M210 167h207"></path>
          </svg>
          <div class="hiw-reference-art step-two-reference" aria-hidden="true"><img src="/images/how-it-works/step2.webp" width="340" height="196" alt="" loading="lazy" decoding="async" draggable="false" /></div>
        </article>

        <article class="hiw-step hiw-step-three" data-hiw-reveal data-hiw-timer>
          <div class="hiw-step-copy">
            <span>03</span><h3>{copy.steps[2][0]}</h3><p>{copy.steps[2][1]}</p>
          </div>
          <svg class="step-art timer-art" viewBox="0 0 520 320" fill="none" aria-hidden="true">
            <path class="desk-line" d="M25 281h470"></path>
            <rect x="55" y="45" width="113" height="187" rx="24"></rect><path d="M92 58h38M95 217h32M111 232v20M83 270h60M92 252h38"></path>
            <circle cx="111" cy="246" r="9"></circle><path d="M103 239 74 270M119 239l28 31"></path>
            <circle class="timer-track" cx="111" cy="139" r="42"></circle><path class="timer-live" pathLength="1" d="M111 97a42 42 0 1 1-31 70"></path>
            <text data-hiw-timer-text x="111" y="147" text-anchor="middle">40:00</text>
            <circle cx="308" cy="93" r="33"></circle><path d="M260 281c3-67 11-107 34-146M368 281c-3-68-12-107-37-146M286 138c18 16 38 17 56 0M303 180l-32 51M312 180l52 29"></path>
            <path d="M363 209l-55 9M307 218l-37 12M312 218l39 16M262 247h113"></path>
            <path class="art-soft" d="M390 215h58v66M383 281h79M421 160c8-24 23-39 40-43-1 24-14 42-39 51M426 173c20-14 39-12 51-3-11 19-29 27-51 17M451 187v45M430 232h42M465 244h35M470 244v37M493 244v37"></path>
          </svg>
          <div class="hiw-reference-art step-three-reference" aria-hidden="true"><img src="/images/how-it-works/step3.webp" width="372" height="188" alt="" loading="lazy" decoding="async" draggable="false" /></div>
        </article>

        <article class="hiw-step hiw-step-four" data-hiw-reveal>
          <div class="hiw-step-copy">
            <span>04</span><h3>{copy.steps[3][0]}</h3><p>{copy.steps[3][1]}</p>
          </div>
          <svg class="step-art reminder-art" viewBox="0 0 560 330" fill="none" aria-hidden="true">
            <rect x="35" y="73" width="87" height="143" rx="20"></rect><path d="M66 86h27M69 202h21M77 216v20M48 256h59M58 236h39"></path>
            <circle cx="78" cy="230" r="8"></circle><path d="M71 224 46 255M85 224l25 31"></path>
            <g class="reminder-bell"><path d="M98 133a20 20 0 0 0-40 0c0 22-11 23-11 29h62c0-6-11-7-11-29ZM71 172h14"></path></g>
            <path class="sound-wave wave-one" d="M132 116c18 18 18 47 0 65"></path><path class="sound-wave wave-two" d="M150 99c29 30 29 76 0 104"></path>
            <circle cx="355" cy="83" r="36"></circle><path d="M302 296c5-65 19-112 39-166M414 296c-3-64-16-109-43-166M335 128c16 14 35 16 51 0M347 169l-39 57M367 166l40 54M307 226l42 5M349 231l52 18M299 296h119"></path>
            <path d="M405 222c18 14 29 33 33 58M419 296h59M430 280v16"></path>
            <path class="posture-line" stroke-dasharray="9 10" d="M381 142c48 27 72 73 68 132"></path>
          </svg>
          <div class="hiw-reference-art step-four-reference" aria-hidden="true"><img src="/images/how-it-works/step4.webp" width="380" height="220" alt="" loading="lazy" decoding="async" draggable="false" /></div>
        </article>
      </div>

      <aside class="hiw-privacy" data-hiw-reveal>
        <svg viewBox="0 0 330 150" fill="none" aria-hidden="true">
          <rect x="17" y="22" width="54" height="100" rx="13"></rect><path d="M35 32h18M37 110h14"></path>
          <path class="privacy-flow" d="M82 73h62M186 73h64"></path>
          <circle class="privacy-lock-bg" cx="165" cy="73" r="32"></circle>
          <rect class="privacy-lock" x="150" y="68" width="30" height="25" rx="4"></rect><path class="privacy-lock" d="M156 68v-7a9 9 0 0 1 18 0v7"></path>
          <rect x="260" y="12" width="55" height="120" rx="5"></rect>
        </svg>
        <div class="hiw-reference-art privacy-reference" aria-hidden="true"><img src="/images/how-it-works/privacy.webp" width="405" height="111" alt="" loading="lazy" decoding="async" draggable="false" /></div>
        <div><h2>{copy.privacyTitle}</h2><p>{copy.privacyBody}</p></div>
      </aside>

    </div>
  </section>
</article>

<style>
  .hiw-page { overflow: hidden; background: var(--paper); }
  .hiw-page .container { width: min(calc(100% - clamp(2rem,14vw,10rem)),1180px); }
  .hiw-hero { border-bottom: 1px solid var(--border); background: var(--paper); padding: clamp(3.4rem,5vw,5.25rem) 0 clamp(2.5rem,4vw,3.75rem); }
  .hiw-hero-grid { display: grid; grid-template-columns: minmax(0,1.03fr) minmax(360px,.97fr); align-items: center; gap: clamp(2.5rem,5vw,5rem); }
  .hiw-hero-content { min-width: 0; }
  .hiw-hero-copy h1 { max-width: 650px; margin: 0; font-family: var(--font-display); font-size: clamp(3.15rem,4.35vw,4.35rem); font-weight: 400; letter-spacing: -.068em; line-height: 1.01; text-wrap: balance; }
  .hiw-hero-copy h1 span { display: block; white-space: nowrap; }
  .lang-zh .hiw-hero-copy h1 { font-size: clamp(43px,4.4vw,62px); letter-spacing: -.075em; }
  .lang-ja .hiw-hero-copy h1 { font-size: clamp(3rem,4.1vw,4.1rem); letter-spacing: -.075em; }
  .hiw-intro { max-width: 620px; margin: 1.35rem 0 0; color: var(--muted); font-size: clamp(.95rem,1.3vw,1.12rem); }
  .hiw-hero-scene { min-height: 350px; }
  .hiw-hero-scene > svg,.hiw-step > .step-art,.hiw-privacy > svg { display: none; }
  .hiw-reference-art { position: relative; z-index: 2; width: 100%; overflow: hidden; pointer-events: none; }
  .hiw-reference-art img { display: block; width: 100%; height: auto; user-select: none; }
  .hero-reference img,.step-one-reference img,.step-three-reference img,.privacy-reference img { mix-blend-mode: multiply; }
  .hero-reference { aspect-ratio: 366 / 300; }
  .step-one-reference { aspect-ratio: 330 / 190; }
  .step-two-reference { aspect-ratio: 340 / 196; }
  .step-three-reference { aspect-ratio: 372 / 188; }
  .step-four-reference { aspect-ratio: 380 / 220; }
  .privacy-reference { aspect-ratio: 405 / 111; }
  .hiw-hero-scene svg { width: 100%; height: 100%; stroke: var(--text); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .hiw-hero-scene .scene-faint,.hiw-hero-scene .art-soft { stroke: rgba(17,19,17,.3); }
  .hiw-hero-scene .scene-paper { fill: var(--paper-soft); }
  .hiw-hero-scene .timer-ring { stroke: var(--accent-text); stroke-width: 2.5; }
  .hiw-hero-scene text { fill: var(--text); stroke: none; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-weight: 700; }
  .hiw-hero-scene .timer-value { font-size: 28px; }
  .hiw-hero-scene .timer-label { font-family: inherit; font-size: 13px; }
  .hiw-checks { display: flex; flex-wrap: wrap; gap: 1rem 2.2rem; margin: clamp(2.25rem,4vw,3.5rem) 0 0; border-top: 1px solid var(--border); padding: 1.35rem 0 0; list-style: none; }
  .hiw-checks li { display: flex; align-items: center; gap: .65rem; color: #4d534e; font-size: .83rem; font-weight: 700; }
  .hiw-checks i { display: grid; width: 22px; height: 22px; place-items: center; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-size: .68rem; font-style: normal; }
  .hiw-journey { background: var(--paper-soft); padding: clamp(2.4rem,3.8vw,4rem) 0 clamp(3rem,4.5vw,4.5rem); }
  .hiw-journey-heading { margin-bottom: clamp(1.4rem,2.5vw,2.2rem); text-align: center; }
  .hiw-journey-heading h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2.35rem,3.2vw,3.6rem); font-weight: 400; letter-spacing: -.055em; }
  .hiw-journey-heading i { display: block; width: 68px; height: 3px; margin: 1rem auto 0; background: var(--accent); }
  .hiw-flow { position: relative; display: grid; gap: 1.15rem; }
  .hiw-step { position: relative; display: grid; min-height: 250px; grid-template-columns: minmax(270px,.82fr) minmax(0,1.18fr); align-items: center; gap: clamp(1.5rem,4vw,4rem); overflow: hidden; border: 1px solid var(--border); border-radius: 24px; background: rgba(255,255,255,.48); padding: clamp(1.4rem,2.5vw,2.1rem); box-shadow: 0 12px 30px rgba(17,19,17,.04); }
  .hiw-step .hiw-reference-art { width: min(100%,390px); justify-self: end; }
  .hiw-step-copy { position: relative; z-index: 4; }
  .hiw-step-copy > span { display: block; color: #76b300; font-family: var(--font-display); font-size: clamp(2.6rem,4vw,4.2rem); line-height: .85; }
  .hiw-step h3 { margin: 1.1rem 0 0; font-family: var(--font-display); font-size: clamp(1.85rem,2.65vw,3rem); font-weight: 400; letter-spacing: -.055em; line-height: 1.04; }
  .hiw-step p { max-width: 420px; margin: .8rem 0 0; color: var(--muted); font-size: .93rem; }
  .step-art { position: relative; z-index: 2; width: 100%; max-height: 245px; stroke: var(--text); stroke-width: 2.15; stroke-linecap: round; stroke-linejoin: round; }
  .phone-screen { fill: var(--dark); }
  .art-soft { stroke: rgba(17,19,17,.25); }
  .art-accent,.frame-corner,.scan-line,.timer-live,.sound-wave,.posture-line { stroke: #76b300; }
  .desk-line { stroke: rgba(17,19,17,.4); }
  .hiw-step-two { border-color: rgba(255,255,255,.12); background: var(--dark); color: var(--paper); }
  .hiw-step-two p { color: rgba(248,245,239,.6); }
  .hiw-step-two .step-art { stroke: rgba(248,245,239,.88); }
  .hiw-step-two .art-accent,.hiw-step-two .frame-corner,.hiw-step-two .scan-line { stroke: var(--accent); }
  .scan-line { stroke-dasharray: 8 10; animation: hiw-scan 3.2s linear infinite; }
  @keyframes hiw-scan { 50% { transform: translateY(48px); } }
  .timer-track { stroke: rgba(17,19,17,.22); }
  .timer-live { stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .hiw-step-three.is-visible .timer-live { animation: hiw-timer 2.8s cubic-bezier(.22,1,.36,1) .6s forwards; }
  @keyframes hiw-timer { to { stroke-dashoffset: .06; } }
  .timer-art text { fill: var(--text); stroke: none; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-size: 22px; font-weight: 750; }
  .hiw-step-four { grid-template-columns: minmax(300px,.86fr) minmax(0,1.14fr); border-color: transparent; background: var(--dark); color: var(--paper); }
  .hiw-step-four::before { position: absolute; z-index: 0; inset: 0 auto 0 0; width: 46%; background: var(--accent); clip-path: polygon(0 0,100% 0,88% 57%,88% 100%,0 100%); content: ''; }
  .hiw-step-four::after { position: absolute; z-index: 6; inset: 0; border: 1px solid var(--border); border-radius: inherit; pointer-events: none; content: ''; }
  .hiw-step-four .hiw-step-copy { max-width: 330px; color: var(--accent-ink); }
  .hiw-step-four .hiw-step-copy > span { color: var(--accent-ink); }
  .hiw-step-four p { color: rgba(16,22,0,.68); }
  .hiw-step-four .step-art { stroke: rgba(248,245,239,.9); }
  .hiw-step-four .sound-wave,.hiw-step-four .posture-line { stroke: var(--accent); }
  .hiw-step-four.is-visible .reminder-bell { animation: hiw-ring 1.15s cubic-bezier(.22,1,.36,1) 1s both; transform-box: fill-box; transform-origin: 50% 10%; }
  @keyframes hiw-ring { 0%,100%{transform:rotate(0)} 25%{transform:rotate(-7deg)} 50%{transform:rotate(7deg)} 75%{transform:rotate(-3deg)} }
  .hiw-privacy { display: grid; grid-template-columns:minmax(260px,.9fr) minmax(0,1.1fr); align-items: center; gap: clamp(2rem,4vw,4rem); margin-top: 1.15rem; border: 1px solid var(--border); border-radius: 22px; background: rgba(255,255,255,.44); padding: clamp(1.25rem,2.1vw,1.8rem); }
  .hiw-privacy .privacy-reference { width: min(100%,360px); justify-self: center; }
  .hiw-privacy svg { width: 100%; max-height: 120px; stroke: var(--text); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .hiw-privacy .privacy-flow { stroke: rgba(17,19,17,.28); stroke-dasharray: 3 6; }
  .hiw-privacy .privacy-lock-bg { fill: var(--accent); stroke: none; }
  .hiw-privacy .privacy-lock { fill: none; stroke: var(--accent-ink); }
  .hiw-privacy h2 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem,3vw,3.25rem); font-weight: 400; letter-spacing: -.055em; }
  .hiw-privacy p { max-width: 610px; margin: .7rem 0 0; color: var(--muted); }
  :global(html.hiw-motion) [data-hiw-reveal]:not(.is-visible) { opacity: 0; filter: blur(5px); transform: translateY(28px); }
