---
import AppStoreButton from './AppStoreButton.astro';
import { getLocaleFromPath, localizedPath, type Locale } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const title = {
  en: 'Scan to view download options',
  zh: '扫码查看下载方式',
  ja: 'QRコードでダウンロード方法を見る',
}[locale];
const qrLabel = {
  en: 'Open the Posturely download guide',
  zh: '打开 Posturely 下载说明页',
  ja: 'Posturely のダウンロードガイドを開く',
}[locale];
const qrImages: Record<Locale, string> = {
  en: '/images/posturely-download-guide-en-qr.png',
  zh: '/images/posturely-download-guide-zh-qr.png',
  ja: '/images/posturely-download-guide-ja-qr.png',
};
---

<div class="desktop-download">
  <div class="qr-download-card">
    <a
      class="qr-code-link"
      href={localizedPath('/download/', locale)}
      aria-label={qrLabel}
    >
      <img
        src={qrImages[locale]}
        width="496"
        height="496"
        alt=""
        loading="eager"
        decoding="async"
      />
    </a>
    <div class="qr-download-content">
      <p>{title}</p>
    </div>
  </div>
</div>
<div class="mobile-download">
  <AppStoreButton />
</div>

<style>
  .desktop-download {
    flex-shrink: 0;
  }

  .mobile-download {
    display: none;
  }

  .qr-download-card {
    display: grid;
    flex-shrink: 0;
    width: min(100%, 330px);
    grid-template-columns: 126px minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.9);
    padding: 0.85rem;
    box-shadow: 0 14px 34px rgba(17, 19, 17, 0.08);
  }

  .qr-code-link {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
  }

  .qr-code-link:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  .qr-code-link img {
    display: block;
    width: 100%;
    height: auto;
  }

  .qr-download-content {
    display: grid;
    align-content: center;
  }

  .qr-download-content p {
    margin: 0;
    color: var(--text);
    font-size: 0.94rem;
    font-weight: 760;
    line-height: 1.35;
  }

  @media (max-width: 720px) {
    .desktop-download {
      display: none;
    }

    .mobile-download {
      display: block;
    }
  }
</style>
