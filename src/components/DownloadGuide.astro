---
import { getLocaleFromPath, type Locale } from '../i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const copy = {
  en: {
    title: 'Download Posturely.',
    intro: 'Search for Posturely in the App Store and look for the app icon.',
    scanLabel: 'Scan on your phone',
    scanAlt: 'QR code for the English Posturely download page',
  },
  zh: {
    title: '下载 Posturely。',
    intro: '在 App Store 搜索 Posturely，认准应用图标。',
    scanLabel: '手机扫码查看',
    scanAlt: 'Posturely 中文下载页二维码',
  },
  ja: {
    title: 'Posturely をダウンロード。',
    intro: 'App Store で Posturely を検索し、アプリアイコンをご確認ください。',
    scanLabel: 'スマートフォンでスキャン',
    scanAlt: 'Posturely 日本語ダウンロードページの QR コード',
  },
}[locale];

const qrImages: Record<Locale, string> = {
  en: '/images/posturely-download-guide-en-qr.png',
  zh: '/images/posturely-download-guide-zh-qr.png',
  ja: '/images/posturely-download-guide-ja-qr.png',
};
---

<article class:list={['download-guide', `lang-${locale}`]}>
  <section class="download-stage" aria-labelledby="download-title">
    <div class="download-shell">
      <header class="download-copy" data-download-reveal>
        <h1 id="download-title">{copy.title}</h1>
        <p>{copy.intro}</p>
      </header>

      <div class="download-cards">
        <section class="download-card app-card" aria-label="Posturely" data-download-reveal style="--reveal-delay: 120ms">
          <img src="/images/posturely-app-icon.png" width="192" height="192" alt="Posturely" />
          <h2>Posturely</h2>
        </section>

        <section class="download-card qr-card" aria-label={copy.scanLabel} data-download-reveal style="--reveal-delay: 220ms">
          <div class="qr-frame">
            <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
            <img src={qrImages[locale]} width="328" height="328" alt={copy.scanAlt} />
          </div>
          <h2>{copy.scanLabel}</h2>
        </section>
      </div>
    </div>
  </section>
</article>

<script>
  let cleanupDownloadMotion: (() => void) | null = null;

  const initializeDownloadMotion = () => {
    cleanupDownloadMotion?.();
    const targets = [...document.querySelectorAll<HTMLElement>('[data-download-reveal]')];
    if (targets.length === 0) {
      document.documentElement.classList.remove('download-motion');
      return;
    }

    document.documentElement.classList.add('download-motion');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let observer: IntersectionObserver | null = null;

    if (reduceMotion || !('IntersectionObserver' in window)) {
      targets.forEach((target) => target.classList.add('is-visible'));
    } else {
      observer = new IntersectionObserver((entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          currentObserver.unobserve(entry.target);
        });
      }, { threshold: .08 });
      targets.forEach((target) => observer?.observe(target));
    }

    cleanupDownloadMotion = () => {
      observer?.disconnect();
      document.documentElement.classList.remove('download-motion');
    };
  };

  document.addEventListener('astro:page-load', initializeDownloadMotion);
  document.addEventListener('astro:before-swap', () => cleanupDownloadMotion?.());
</script>
