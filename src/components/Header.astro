---
import { navigation, siteConfig } from '../config/site';
import { common, getLocaleFromPath, locales, localizedPath, stripLocalePath } from '../i18n';

const pathname = Astro.url.pathname;
const locale = getLocaleFromPath(pathname);
const copy = common[locale];
const normalizedPath = (value: string) => {
  const stripped = stripLocalePath(value).replace(/\/+$/, '');
  return stripped || '/';
};
const currentPath = normalizedPath(pathname);
const navigationItems = navigation.map((item, index) => ({
  href: localizedPath(item.href, locale),
  label: copy.nav[index],
  current: normalizedPath(item.href) === currentPath,
}));
const currentPageLabel = navigationItems.find((item) => item.current)?.label
  ?? (currentPath === '/download' ? { en: 'Download', zh: '下载', ja: 'ダウンロード' }[locale] : siteConfig.siteName);
const languagePickerTitle = {
  en: 'Choose language',
  zh: '选择语言',
  ja: '言語を選択',
}[locale];
const languageTriggerLabels = {
  en: 'English',
  zh: '中文',
  ja: '日本語',
} as const;
const languageMenuNames = {
  en: 'English',
  zh: '简体中文',
  ja: '日本語',
} as const;
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <div class="header-inner">
    <a class="brand" href={localizedPath('/', locale)} aria-label={`${siteConfig.siteName} ${copy.nav[0]}`}>
      <span class="brand-mark" aria-hidden="true">
        <img
          src="/images/posturely-app-icon-96.webp"
          srcset="/images/posturely-app-icon-96.webp 96w, /images/posturely-app-icon.webp 192w"
          sizes="38px"
          width="192"
          height="192"
          alt=""
        />
      </span>
      <span>{siteConfig.siteName}</span>
    </a>

    <nav class="primary-nav" aria-label={copy.menu}>
      {navigationItems.map((item) => (
        <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <p class="mobile-current" aria-label={`${currentPageLabel}, ${copy.menu}`}>{currentPageLabel}</p>

    <details class="language">
      <summary aria-label={copy.language} title={copy.language}>
        <svg class="language-globe" aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9"></circle><ellipse cx="12" cy="12" rx="4" ry="9"></ellipse><path d="M3 12h18M5 6.5a16 16 0 0 0 14 0M5 17.5a16 16 0 0 1 14 0"></path></svg>
        <span>{languageTriggerLabels[locale]}</span>
        <svg class="language-chevron" aria-hidden="true" viewBox="0 0 12 8" fill="none"><path d="m2 2 4 4 4-4"></path></svg>
      </summary>
      <div class="language-panel" role="group" aria-label={languagePickerTitle}>
        {locales.map((item) => (
          <a href={localizedPath(pathname, item)} lang={item} aria-current={item === locale ? 'page' : undefined}>
            <span>{languageMenuNames[item]}</span>
            {item === locale && <svg class="language-check" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="m3 8.5 3 3 7-7"></path></svg>}
          </a>
        ))}
      </div>
    </details>

    <details class="mobile-menu">
      <summary>{copy.menu}<span aria-hidden="true"></span></summary>
      <div class="mobile-menu-panel">
        <nav aria-label={copy.menu}>
          {navigationItems.map((item) => (
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              <span>{item.label}</span>
              {item.current && <i aria-hidden="true"></i>}
            </a>
          ))}
        </nav>
        <div class="mobile-languages">
          <p>{languagePickerTitle}</p>
          <div>
            {locales.map((item) => (
              <a href={localizedPath(pathname, item)} lang={item} aria-current={item === locale ? 'page' : undefined}>
                {languageMenuNames[item]}
              </a>
            ))}
          </div>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; z-index: 50; top: 0; border-bottom: 1px solid rgba(17,19,17,.09); background: rgba(248,245,239,.82); box-shadow: inset 0 1px 0 rgba(255,255,255,.4); -webkit-backdrop-filter: saturate(140%) blur(24px); backdrop-filter: saturate(140%) blur(24px); transition: background-color 240ms ease, border-color 240ms ease; }
  .header-inner { display: grid; width: min(calc(100% - 64px), 1440px); min-height: 84px; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; gap: clamp(2rem, 5vw, 5rem); margin-inline: auto; transition: min-height 280ms cubic-bezier(.22,1,.36,1); }
  .site-header.is-compact { border-bottom-color: rgba(17,19,17,.14); background: rgba(248,245,239,.94); }
  .site-header.is-compact .header-inner { min-height: 68px; }
  .brand { display: inline-flex; align-items: center; gap: .68rem; font-size: 1.18rem; font-weight: 780; letter-spacing: -.03em; white-space: nowrap; }
  .brand-mark { display: block; width: 38px; height: 38px; overflow: hidden; border-radius: 10px; background: #050708; }
  .brand-mark img { width: 100%; height: 100%; object-fit: cover; }
  .primary-nav { display: flex; height: 100%; align-items: stretch; justify-content: center; gap: clamp(1.25rem, 2.6vw, 2.75rem); }
  .primary-nav a { position: relative; display: flex; align-items: center; color: var(--muted); font-size: .86rem; font-weight: 560; white-space: nowrap; transition: color 170ms ease; }
  .primary-nav a:hover { color: var(--text); }
  .primary-nav a[aria-current='page'] { color: var(--text); font-weight: 750; }
  .primary-nav a[aria-current='page']::after { position: absolute; top: calc(50% + 1rem); right: 0; left: 0; height: 3px; border-radius: 999px; background: var(--accent-text); content: ''; }
  .language { position: relative; justify-self: end; }
  .language summary { display: flex; min-height: 44px; cursor: pointer; align-items: center; gap: .45rem; border: 1px solid rgba(17,19,17,.18); border-radius: 999px; background: rgba(255,255,255,.75); padding: .55rem .9rem; color: var(--text); font-size: .84rem; font-weight: 560; list-style: none; box-shadow: 0 2px 3px rgba(17,19,17,.04); transition: border-color 180ms ease, background-color 180ms ease, box-shadow 180ms ease, transform 180ms cubic-bezier(.22,1,.36,1); }
  .language summary::-webkit-details-marker, .mobile-menu summary::-webkit-details-marker { display: none; }
  .language summary:hover, .language[open]:not([data-closing]) summary { border-color: rgba(17,19,17,.32); background: #fff; box-shadow: 0 3px 8px rgba(17,19,17,.07); }
  .language summary:active { transform: scale(.96); }
  .language-globe { width: 18px; height: 18px; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .language-chevron { width: 10px; margin-left: .65rem; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: transform 220ms cubic-bezier(.22,1,.36,1); }
  .language[open]:not([data-closing]) .language-chevron { transform: rotate(180deg); }
  .language-panel { position: absolute; top: calc(100% + .8rem); right: 0; display: grid; width: 192px; gap: .15rem; overflow: hidden; border: 1px solid rgba(17,19,17,.09); border-radius: 13px; background: #fff; padding: .45rem; box-shadow: 0 3px 6px rgba(17,19,17,.025), 0 10px 24px -8px rgba(17,19,17,.13); transform-origin: top right; }
  .mobile-menu[open] .mobile-menu-panel { animation: panel-in 300ms cubic-bezier(.22,1,.36,1) both; }
  .language-panel a { display: grid; min-height: 44px; grid-template-columns: 1fr 16px; align-items: center; gap: .75rem; border-radius: 8px; padding: .55rem .75rem; color: var(--text); font-size: .84rem; transition: background-color 160ms ease, transform 160ms cubic-bezier(.22,1,.36,1); }
  .language-panel a:hover { background: #f5f4f0; }
  .language-panel a:active { transform: scale(.98); }
  .language-panel a[aria-current='page'] { background: #eff6da; font-weight: 600; }
  .language-panel a[aria-current='page']:hover { background: #e8f1ca; }
  .language summary:focus-visible, .language-panel a:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 3px; }
  .language-panel a:focus-visible { outline-offset: -2px; }
  .language-check { width: 16px; color: var(--accent-text); stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .mobile-current, .mobile-menu { display: none; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(-7px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @media (max-width: 1080px) {
    .header-inner { width: min(calc(100% - 40px), 1440px); gap: 2rem; }
    .primary-nav { gap: 1.2rem; }
    .primary-nav a { font-size: .8rem; }
  }
  @media (max-width: 820px) {
    .header-inner { width: min(calc(100% - 28px), 1440px); min-height: 72px; grid-template-columns: auto minmax(0,1fr) auto; gap: .85rem; }
    .site-header.is-compact .header-inner { min-height: 62px; }
    .brand { gap: .5rem; font-size: 1rem; }
    .brand-mark { width: 32px; height: 32px; border-radius: 8px; }
    .primary-nav, .language { display: none; }
    .mobile-current { display: block; overflow: hidden; margin: 0; font-size: .8rem; font-weight: 720; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
    .mobile-menu { position: relative; display: block; justify-self: end; }
    .mobile-menu summary { display: flex; min-width: 66px; min-height: 40px; cursor: pointer; align-items: center; justify-content: center; gap: .5rem; border: 1px solid rgba(17,19,17,.38); border-radius: 999px; padding: 0 .8rem; font-size: .78rem; font-weight: 700; list-style: none; }
    .mobile-menu summary span { position: relative; width: 12px; height: 8px; border-top: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; }
    .mobile-menu summary span::after { position: absolute; top: 2px; right: 0; left: 0; border-top: 1.5px solid currentColor; content: ''; }
    .mobile-menu-panel { position: absolute; top: calc(100% + .65rem); right: 0; width: min(326px, calc(100vw - 28px)); overflow: hidden; border: 1px solid rgba(17,19,17,.1); border-radius: 18px; background: rgba(255,255,255,.97); padding: .6rem; box-shadow: 0 20px 55px rgba(17,19,17,.16); backdrop-filter: blur(20px); transform-origin: top right; }
    .mobile-menu-panel nav { display: grid; }
    .mobile-menu-panel nav a { display: flex; min-height: 48px; align-items: center; justify-content: space-between; border-radius: 11px; padding: .6rem .75rem; color: var(--muted); font-size: .88rem; }
    .mobile-menu-panel nav a:hover { background: var(--paper-soft); color: var(--text); }
    .mobile-menu-panel nav a[aria-current='page'] { background: var(--paper-soft); color: var(--text); font-weight: 760; }
    .mobile-menu-panel nav i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-text); }
    .mobile-languages { margin-top: .45rem; border-top: 1px solid var(--border); padding: .85rem .75rem .35rem; }
    .mobile-languages > p { margin: 0 0 .65rem; color: var(--subtle); font-size: .72rem; font-weight: 680; }
    .mobile-languages > div { display: flex; flex-wrap: wrap; gap: .4rem; }
    .mobile-languages a { min-height: 44px; display: inline-flex; align-items: center; border: 1px solid transparent; border-radius: 8px; padding: .42rem .68rem; color: var(--muted); font-size: .72rem; transition: background-color 160ms ease, transform 160ms ease; }
    .mobile-languages a:hover { background: #f5f4f0; }
    .mobile-languages a:active { transform: scale(.97); }
    .mobile-languages a[aria-current='page'] { background: #eff6da; color: var(--accent-text); font-weight: 600; }
  }
  @media (max-width: 360px) {
    .brand > span:last-child { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header, .header-inner, .primary-nav a, .language summary, .language-chevron, .language-panel, .language-panel a, .mobile-menu-panel, .mobile-languages a { animation: none !important; transition: none !important; }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header, .site-header.is-compact { background: rgba(248,245,239,.98); }
  }
</style>

<script>
  let languageScrollPosition: { x: number; y: number } | null = null;
  const languageAnimations = new WeakMap<HTMLDetailsElement, Animation>();

  const setLanguageOpen = (menu: HTMLDetailsElement, open: boolean, animate = true) => {
    const panel = menu.querySelector<HTMLElement>('.language-panel');
    if (!panel) return;
    const previous = languageAnimations.get(menu);
    const current = getComputedStyle(panel);
    const from = { opacity: current.opacity, transform: current.transform };
    previous?.cancel();
    languageAnimations.delete(menu);

    menu.querySelector('summary')?.setAttribute('aria-expanded', String(open));
    menu.toggleAttribute('data-closing', !open);
    panel.inert = !open;
    if (open) menu.open = true;

    const finish = () => {
      menu.open = open;
      menu.removeAttribute('data-closing');
      panel.inert = false;
    };
    if (!animate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      finish();
      return;
    }

    const hidden = { opacity: '0', transform: 'translateY(-6px) scale(.97)' };
    const visible = { opacity: '1', transform: 'translateY(0) scale(1)' };
    const animation = panel.animate([previous ? from : open ? hidden : visible, open ? visible : hidden], {
      duration: open ? 220 : 150,
      easing: open ? 'cubic-bezier(.22,1,.36,1)' : 'cubic-bezier(.4,0,1,1)',
      fill: 'both',
    });
    languageAnimations.set(menu, animation);
    animation.onfinish = () => {
      finish();
      animation.cancel();
      languageAnimations.delete(menu);
    };
  };

  const closeHeaderMenu = (menu: HTMLDetailsElement, animate = true) => {
    if (!menu.classList.contains('language')) {
      menu.open = false;
    } else if (!animate || !menu.hasAttribute('data-closing')) {
      setLanguageOpen(menu, false, animate);
    }
  };

  const closeHeaderMenus = (animate = true) => {
    document.querySelectorAll<HTMLDetailsElement>('.site-header details[open]').forEach((menu) => closeHeaderMenu(menu, animate));
  };

  let headerFrame = 0;
  const updateHeaderState = () => {
    headerFrame = 0;
    document.querySelector<HTMLElement>('.site-header')?.classList.toggle('is-compact', window.scrollY > 24);
  };
  const requestHeaderState = () => {
    if (headerFrame) return;
    headerFrame = requestAnimationFrame(updateHeaderState);
  };

  window.addEventListener('scroll', requestHeaderState, { passive: true });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const languageTrigger = target.closest('.language summary');
    if (languageTrigger) {
      const menu = languageTrigger.closest<HTMLDetailsElement>('details');
      if (menu) {
        event.preventDefault();
        setLanguageOpen(menu, !menu.open || menu.hasAttribute('data-closing'));
      }
      return;
    }

    const languageLink = target.closest<HTMLAnchorElement>('.language-panel a, .mobile-languages a');
    if (languageLink) {
      const isCurrentLanguage = languageLink.getAttribute('aria-current') === 'page';
      languageScrollPosition = isCurrentLanguage ? null : { x: window.scrollX, y: window.scrollY };
      closeHeaderMenus();
      if (isCurrentLanguage) event.preventDefault();
      return;
    }

    const currentNavigationLink = target.closest<HTMLAnchorElement>('.site-header nav a[aria-current="page"]');
    if (currentNavigationLink) {
      event.preventDefault();
      closeHeaderMenus();
      return;
    }

    if (!target.closest('.site-header details')) closeHeaderMenus();
  });

  document.addEventListener('toggle', (event) => {
    const opened = event.target;
    if (!(opened instanceof HTMLDetailsElement) || !opened.open || !opened.closest('.site-header')) return;
    document.querySelectorAll<HTMLDetailsElement>('.site-header details[open]').forEach((menu) => {
      if (menu !== opened) closeHeaderMenu(menu);
    });
  }, true);

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const focusedMenu = document.activeElement?.closest<HTMLDetailsElement>('.site-header details[open]');
    focusedMenu?.querySelector('summary')?.focus();
    closeHeaderMenus();
  });

  document.addEventListener('focusout', (event) => {
    if (!(event.target instanceof Element)) return;
    const menu = event.target.closest<HTMLDetailsElement>('.language[open]');
    if (menu && event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) closeHeaderMenu(menu);
  });

  document.addEventListener('astro:page-load', () => {
    closeHeaderMenus(false);
    if (!languageScrollPosition) {
      updateHeaderState();
      return;
    }
    const { x, y } = languageScrollPosition;
    languageScrollPosition = null;
    requestAnimationFrame(() => {
      const previousScrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo({ left: x, top: y, behavior: 'auto' });
      document.documentElement.style.scrollBehavior = previousScrollBehavior;
      updateHeaderState();
    });
  });
</script>
