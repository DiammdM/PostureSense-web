---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogCard from '../../components/BlogCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.locale === 'en')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title="Posturely Blog — Posture Apps, Study and Desk Habits"
  description="Practical articles about posture reminder apps, study posture, desk setup, privacy, and building better posture awareness during focused work."
  canonical="/blog/"
>
  <PageHero
    eyebrow="Posturely journal"
    title="Practical ideas for more aware desk time."
    description="Clear, non-medical guidance about posture reminders, study and work setups, app privacy, and the habits that shape a long desk session."
  />
  <section class="blog-section">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />
      <div class="blog-grid">
        {posts.map((post) => (
          <BlogCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-section {
    border-top: 1px solid var(--border);
    padding: 2rem 0 7rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  .blog-grid > :first-child {
    grid-column: 1 / -1;
  }

  @media (max-width: 720px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .blog-grid > :first-child {
      grid-column: auto;
    }
  }
</style>
