---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import CtaBand from '../../components/CtaBand.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.locale === 'en');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical = post.data.canonical ?? `/blog/${post.id}/`;
const canonicalUrl = new URL(canonical, siteConfig.siteUrl).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: { '@type': 'Organization', name: siteConfig.developerName, url: siteConfig.siteUrl },
  mainEntityOfPage: canonicalUrl,
  ...(post.data.image ? { image: new URL(post.data.image, siteConfig.siteUrl).toString() } : {}),
};
---

<BaseLayout
  title={`${post.data.title} | Posturely`}
  description={post.data.description}
  canonical={canonical}
  image={post.data.image ?? null}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishDate.toISOString()} />
    {post.data.updatedDate && <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />}
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <JsonLd data={articleJsonLd} />
  </Fragment>
  <article class="article">
    <header class="article-header">
      <div class="container narrow">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: post.data.title }]} />
        <p class="eyebrow">{post.data.tags[0]}</p>
        <h1>{post.data.title}</h1>
        <p class="dek">{post.data.description}</p>
        <div class="byline">
          <span>By {post.data.author}</span>
          <time datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
          <span>{Math.max(4, Math.round((post.body ?? '').split(/\s+/).length / 220))} min read</span>
        </div>
      </div>
    </header>
    <div class="container prose"><Content /></div>
  </article>
  <CtaBand title="Bring posture awareness to your next desk session." />
</BaseLayout>

<style>
  .article-header {
    border-bottom: 1px solid var(--border);
    padding: clamp(3rem, 8vw, 6rem) 0;
  }

  .narrow,
  .prose {
    max-width: 820px;
  }

  .article-header .eyebrow {
    margin-top: 4rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 8vw, 5.8rem);
    letter-spacing: -0.06em;
    line-height: 0.99;
    font-weight: 450;
  }

  .dek {
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.5rem;
    margin-top: 2rem;
    color: var(--subtle);
    font-size: 0.78rem;
  }

  .prose {
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: 2rem;
    color: #373c37;
    font-size: clamp(1rem, 1.8vw, 1.08rem);
  }

  .prose :global(h2) {
    margin: 3.5rem 0 1rem;
    color: var(--text);
    font-size: clamp(1.65rem, 4vw, 2.35rem);
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .prose :global(p) {
    margin: 0 0 1.35rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.55rem;
    padding-left: 0.35rem;
  }

  .prose :global(a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
