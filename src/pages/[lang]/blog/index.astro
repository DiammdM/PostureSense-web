---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogCard from '../../../components/BlogCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { localizedContent } from '../../../data/localized';

export function getStaticPaths() {
  return ['zh', 'ja'].map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: 'zh' | 'ja' }
const { lang } = Astro.props;
const content = localizedContent[lang].blog;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.locale === lang)).sort((a,b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const homeLabel = lang === 'zh' ? '首页' : 'ホーム';
const blogLabel = lang === 'zh' ? '博客' : 'ブログ';
---

<BaseLayout title={content.title} description={content.description} canonical={`/${lang}/blog/`}>
  <PageHero eyebrow={content.eyebrow} title={content.heading} description={content.intro} />
  <section class="blog-section"><div class="container">
    <Breadcrumbs items={[{ label: homeLabel, href: `/${lang}/` }, { label: blogLabel }]} />
    <div class="blog-grid">{posts.map((post) => <BlogCard slug={post.data.translationKey} title={post.data.title} description={post.data.description} publishDate={post.data.publishDate} tags={post.data.tags} basePath={`/${lang}/blog`} readLabel={content.read} />)}</div>
  </div></section>
</BaseLayout>

<style>
  .blog-section{border-top:1px solid var(--border);padding:2rem 0 7rem}.blog-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:3rem}.blog-grid>:first-child{grid-column:1/-1}@media(max-width:720px){.blog-grid{grid-template-columns:1fr}.blog-grid>:first-child{grid-column:auto}}
</style>
