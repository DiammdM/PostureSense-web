---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import JsonLd from '../../../components/JsonLd.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { siteConfig } from '../../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.locale !== 'en');
  return posts.map((post) => ({ params: { lang: post.data.locale, slug: post.data.translationKey }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const lang = post.data.locale as 'zh' | 'ja';
const { Content } = await render(post);
const canonical = `/${lang}/blog/${post.data.translationKey}/`;
const homeLabel = lang === 'zh' ? '首页' : 'ホーム';
const blogLabel = lang === 'zh' ? '博客' : 'ブログ';
const byLabel = lang === 'zh' ? '作者' : '執筆';
const readLabel = lang === 'zh' ? '分钟阅读' : '分で読めます';
const wordCount = (post.body ?? '').replace(/\s/g, '').length;
const readMinutes = Math.max(4, Math.round(wordCount / 500));
const articleJsonLd = {
  '@context':'https://schema.org','@type':'BlogPosting',headline:post.data.title,description:post.data.description,
  datePublished:post.data.publishDate.toISOString(),inLanguage:lang === 'zh' ? 'zh-Hans' : 'ja',
  author:{'@type':'Organization',name:post.data.author},publisher:{'@type':'Organization',name:siteConfig.developerName,url:siteConfig.siteUrl},
  mainEntityOfPage:new URL(canonical,siteConfig.siteUrl).toString(),
};
---

<BaseLayout title={`${post.data.title} | Posturely`} description={post.data.description} canonical={canonical} image={null} type="article">
  <Fragment slot="head"><meta property="article:published_time" content={post.data.publishDate.toISOString()} />{post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}<JsonLd data={articleJsonLd} /></Fragment>
  <article>
    <header class="article-header"><div class="container narrow">
      <Breadcrumbs items={[{label:homeLabel,href:`/${lang}/`},{label:blogLabel,href:`/${lang}/blog/`},{label:post.data.title}]} />
      <p class="eyebrow">{post.data.tags[0]}</p><h1>{post.data.title}</h1><p class="dek">{post.data.description}</p>
      <div class="byline"><span>{byLabel} {post.data.author}</span><time datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'ja-JP',{year:'numeric',month:'long',day:'numeric'})}</time><span>{readMinutes} {readLabel}</span></div>
    </div></header>
    <div class="container prose"><Content /></div>
  </article>
  <CtaBand />
</BaseLayout>

<style>
  .article-header{border-bottom:1px solid var(--border);padding:clamp(3rem,8vw,6rem) 0}.narrow,.prose{max-width:820px}.article-header .eyebrow{margin-top:4rem}h1{margin:0;font-size:clamp(2.8rem,8vw,5.5rem);font-weight:450;letter-spacing:-.06em;line-height:1.03}.dek{margin:1.5rem 0 0;color:var(--muted);font-size:clamp(1.05rem,2vw,1.25rem)}.byline{display:flex;flex-wrap:wrap;gap:.65rem 1.5rem;margin-top:2rem;color:var(--subtle);font-size:.78rem}.prose{padding-top:clamp(3rem,7vw,5rem);padding-bottom:2rem;color:#373c37;font-size:clamp(1rem,1.8vw,1.08rem)}.prose :global(h2){margin:3.5rem 0 1rem;color:var(--text);font-size:clamp(1.65rem,4vw,2.35rem);letter-spacing:-.04em;line-height:1.2}.prose :global(p){margin:0 0 1.35rem}.prose :global(ul),.prose :global(ol){margin:0 0 1.5rem;padding-left:1.25rem}.prose :global(li){margin-bottom:.55rem}
</style>
