---
import AppDocumentLayout from '../../layouts/AppDocumentLayout.astro';
import { privacyPolicyDocuments } from '../../data/privacy-policy';

export function getStaticPaths() {
  return ['zh', 'ja'].map(lang => ({ params: { lang }, props: { lang } }));
}
interface Props { lang: 'zh' | 'ja' }
const { lang } = Astro.props as Props;
---

<AppDocumentLayout documents={privacyPolicyDocuments} canonical="/privacy-policy/" defaultLocale={lang} />
