---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import HomeFeatureShowcase from '../../components/HomeFeatureShowcase.astro';
import HomeStorySections from '../../components/HomeStorySections.astro';
import JsonLd from '../../components/JsonLd.astro';
import { appStore, siteConfig } from '../../config/site';
import { localizedContent } from '../../data/localized';

export function getStaticPaths() {
  return ['zh', 'ja'].map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: 'zh' | 'ja' }
const { lang } = Astro.props;
const content = localizedContent[lang];
const home = content.home;
const softwareApplication = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: siteConfig.siteName,
  applicationCategory: 'LifestyleApplication', operatingSystem: 'iOS, iPadOS',
  url: new URL(`/${lang}/`, siteConfig.siteUrl).toString(), downloadUrl: appStore.url,
  description: home.description, inLanguage: lang === 'zh' ? 'zh-Hans' : 'ja',
  publisher: { '@type': 'Organization', name: siteConfig.developerName, url: siteConfig.siteUrl },
};
---

<BaseLayout title={home.title} description={home.description} canonical={`/${lang}/`}>
  <Fragment slot="head"><JsonLd data={softwareApplication} /></Fragment>
  <Hero />
  <HomeFeatureShowcase />
  <HomeStorySections />
</BaseLayout>
