---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQPage from '../components/FAQPage.astro';
import JsonLd from '../components/JsonLd.astro';
import { faqs } from '../data/faqs';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="Posturely FAQ — Posture Detection, Privacy and Setup"
  description="Answers about Posturely posture detection, on-device camera processing, phone placement, desk use, iPhone and iPad availability, and medical limitations."
  canonical="/faq/"
>
  <Fragment slot="head"><JsonLd data={faqJsonLd} /></Fragment>
  <FAQPage items={faqs.map(({ question, answer }) => [question, answer] as const)} />
</BaseLayout>
