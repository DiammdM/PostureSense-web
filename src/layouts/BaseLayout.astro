---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMotion from '../components/PageMotion.astro';
import SEO from '../components/SEO.astro';
import { ClientRouter, fade } from 'astro:transitions';
import { getLocaleFromPath, localeTags } from '../i18n';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string | null;
  type?: 'website' | 'article';
}

const { title, description, canonical, image, type } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfcf9" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO {title} {description} {canonical} {image} {type} />
    <PageMotion />
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" transition:name="page-content" transition:animate={fade({ duration: 140 })}><slot /></main>
    <Footer />
  </body>
</html>
